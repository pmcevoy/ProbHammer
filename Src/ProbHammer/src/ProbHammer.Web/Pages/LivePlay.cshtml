@page
@model LivePlayModel
@using ProbHammer.Core.Domain.Catalogue
@{
    ViewData["Title"] = "Live Play";
}

<main class="live-play-page">
    <h1>Live Play</h1>

    @for (var i = 0; i < Model.Units.Count; i++)
    {
        var unit = Model.Units[i];
        <section class="unit-block">
            <h2 class="unit-name">@unit.Name</h2>

            @if (unit.Statlines.Any())
            {
                <details class="lp-section">
                    <summary>Statline</summary>
                    <div class="statline-grid">
                        @for (var runIndex = 0; runIndex < unit.Statlines.Count; runIndex++)
                        {
                            var block = unit.Statlines[runIndex];
                            <div class="statline-cell col-statline" style="grid-row: @(runIndex + 1); grid-column: 1;">
                                @for (var entryIndex = 0; entryIndex < block.Entries.Count; entryIndex++)
                                {
                                    var entry = block.Entries[entryIndex];
                                    <div class="statline-header">
                                        <span class="statline-name">@entry.StatlineName</span>
                                        <span class="statline-count">(@(entry.RemainingCount)/@(entry.InitialCount))</span>
                                    </div>
                                    @if (entry.Loadouts.Count > 1)
                                    {
                                        var loadoutLabels = block.LoadoutLabels[entryIndex];
                                        <ul class="loadout-breakdown">
                                            @for (var loadoutIndex = 0; loadoutIndex < entry.Loadouts.Count; loadoutIndex++)
                                            {
                                                var loadout = entry.Loadouts[loadoutIndex];
                                                <li>@loadoutLabels[loadoutIndex] (@(loadout.RemainingCount)/@(loadout.InitialCount))</li>
                                            }
                                        </ul>
                                    }
                                }
                                <div class="statline-tiles">
                                    <div class="stat-tile"><span class="stat-label">M</span><span class="stat-value">@(block.Statline.M)"</span></div>
                                    <div class="stat-tile"><span class="stat-label">T</span><span class="stat-value">@(block.Statline.T)</span></div>
                                    <div class="stat-tile">
                                        <span class="stat-label">Sv</span>
                                        <span class="stat-value">@(block.Statline.Sv)+</span>
                                        @if (block.Statline.InSv > 0)
                                        {
                                            <span class="stat-subvalue">@(block.Statline.InSv)++</span>
                                        }
                                    </div>
                                    <div class="stat-tile"><span class="stat-label">W</span><span class="stat-value">@(block.Statline.W)</span></div>
                                    <div class="stat-tile"><span class="stat-label">Ld</span><span class="stat-value">@(block.Statline.Ld)+</span></div>
                                    <div class="stat-tile"><span class="stat-label">OC</span><span class="stat-value">@(block.Statline.Oc)</span></div>
                                </div>
                            </div>

                            @if (block.ModelAbilities.Any())
                            {
                                <div class="statline-cell col-model-abilities" style="grid-row: @(runIndex + 1); grid-column: 2;">
                                    @foreach (var ability in block.ModelAbilities)
                                    {
                                        <div class="ability-name-line">@ability.Name</div>
                                    }
                                </div>
                            }

                            @if (block.UnitAbilities.Any())
                            {
                                <div class="statline-cell col-unit-abilities" style="grid-row: @(runIndex + 1); grid-column: 3;">
                                    @foreach (var ability in block.UnitAbilities)
                                    {
                                        <div class="ability-name-line">@ability.Name</div>
                                    }
                                </div>
                            }
                        }

                        @foreach (var span in unit.ComponentAbilitySpans)
                        {
                            @if (span.ModelAbilities.Any())
                            {
                                <div class="statline-cell col-model-abilities spans-component" style="grid-row: @(span.FirstRunIndex + 1) / @(span.LastRunIndex + 2); grid-column: 2;">
                                    @foreach (var ability in span.ModelAbilities)
                                    {
                                        <div class="ability-name-line">@ability.Name</div>
                                    }
                                </div>
                            }

                            @if (span.UnitAbilities.Any())
                            {
                                <div class="statline-cell col-unit-abilities spans-component" style="grid-row: @(span.FirstRunIndex + 1) / @(span.LastRunIndex + 2); grid-column: 3;">
                                    @foreach (var ability in span.UnitAbilities)
                                    {
                                        <div class="ability-name-line">@ability.Name</div>
                                    }
                                </div>
                            }
                        }
                    </div>
                </details>
            }

            @if (unit.RangedWeapons.Any())
            {
                <details class="lp-section">
                    <summary>Ranged Weapons</summary>
                    <table class="weapon-table">
                        <colgroup>
                            <col class="col-weapon" />
                            <col class="col-slot" />
                            <col class="col-slot" />
                            <col class="col-slot" />
                            <col class="col-slot" />
                            <col class="col-slot" />
                            <col class="col-slot" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th>Weapon</th>
                                <th>Rng</th>
                                <th>A</th>
                                <th>BS</th>
                                <th>S</th>
                                <th>AP</th>
                                <th>D</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var w = 0; w < unit.RangedWeapons.Count; w++)
                            {
                                var row = unit.RangedWeapons[w];
                                var weapon = row.Entry.Profile;
                                var tags = WeaponAbilityTags(weapon);
                                var weaponId = $"w-{i}-r-{w}";
                                <tr class="@(w % 2 == 1 ? "weapon-row-alt" : "")">
                                    <td class="weapon-name">
                                        @if (row.Breakdown.Count > 0)
                                        {
                                            <button type="button" class="weapon-name-toggle" data-weapon-id="@weaponId" aria-expanded="false">
                                                @weapon.Name
                                                @if (tags.Count > 0)
                                                {
                                                    <span class="weapon-tags">[@string.Join(", ", tags)]</span>
                                                }
                                            </button>
                                        }
                                        else
                                        {
                                            @weapon.Name
                                            @if (tags.Count > 0)
                                            {
                                                <span class="weapon-tags">[@string.Join(", ", tags)]</span>
                                            }
                                        }
                                    </td>
                                    <td>@(weapon.Range)"</td>
                                    <td>@row.Entry.TotalAttacks</td>
                                    <td>@(weapon.Skill)+</td>
                                    <td>@weapon.S</td>
                                    <td>@weapon.Ap</td>
                                    <td>@weapon.D</td>
                                </tr>
                                @foreach (var breakdown in row.Breakdown)
                                {
                                    <tr class="weapon-contribution-row @(w % 2 == 1 ? "weapon-row-alt" : "")" data-weapon-id="@weaponId" hidden>
                                        <td class="weapon-contribution-label">@breakdown.Label (@(breakdown.Count)&times;@(breakdown.PerModelAttacks))</td>
                                        <td></td>
                                        <td>@breakdown.Subtotal</td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </details>
            }

            @if (unit.MeleeWeapons.Any())
            {
                <details class="lp-section">
                    <summary>Melee Weapons</summary>
                    <table class="weapon-table">
                        <colgroup>
                            <col class="col-weapon-melee" />
                            <col class="col-slot" />
                            <col class="col-slot" />
                            <col class="col-slot" />
                            <col class="col-slot" />
                            <col class="col-slot" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th>Weapon</th>
                                <th>A</th>
                                <th>WS</th>
                                <th>S</th>
                                <th>AP</th>
                                <th>D</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var w = 0; w < unit.MeleeWeapons.Count; w++)
                            {
                                var row = unit.MeleeWeapons[w];
                                var weapon = row.Entry.Profile;
                                var tags = WeaponAbilityTags(weapon);
                                var weaponId = $"w-{i}-m-{w}";
                                <tr class="@(w % 2 == 1 ? "weapon-row-alt" : "")">
                                    <td class="weapon-name">
                                        @if (row.Breakdown.Count > 0)
                                        {
                                            <button type="button" class="weapon-name-toggle" data-weapon-id="@weaponId" aria-expanded="false">
                                                @weapon.Name
                                                @if (tags.Count > 0)
                                                {
                                                    <span class="weapon-tags">[@string.Join(", ", tags)]</span>
                                                }
                                            </button>
                                        }
                                        else
                                        {
                                            @weapon.Name
                                            @if (tags.Count > 0)
                                            {
                                                <span class="weapon-tags">[@string.Join(", ", tags)]</span>
                                            }
                                        }
                                    </td>
                                    <td>@row.Entry.TotalAttacks</td>
                                    <td>@(weapon.Skill)+</td>
                                    <td>@weapon.S</td>
                                    <td>@weapon.Ap</td>
                                    <td>@weapon.D</td>
                                </tr>
                                @foreach (var breakdown in row.Breakdown)
                                {
                                    <tr class="weapon-contribution-row @(w % 2 == 1 ? "weapon-row-alt" : "")" data-weapon-id="@weaponId" hidden>
                                        <td class="weapon-contribution-label">@breakdown.Label (@(breakdown.Count)&times;@(breakdown.PerModelAttacks))</td>
                                        <td>@breakdown.Subtotal</td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </details>
            }

            @if (unit.Keywords.Any())
            {
                <div class="keywords">@string.Join(", ", unit.Keywords)</div>
            }
        </section>
    }
</main>

@section Scripts {
    <script src="~/js/live-play.js" asp-append-version="true"></script>
}

@functions {
    static List<string> WeaponAbilityTags(WeaponProfile w)
    {
        var tags = new List<string>();
        if (w.Torrent) tags.Add("TORRENT");
        if (w.Blast) tags.Add("BLAST");
        if (w.Melta > 0) tags.Add($"MELTA {w.Melta}");
        if (w.RapidFire > 0) tags.Add($"RAPID FIRE {w.RapidFire}");
        if (w.SustainedHits > 0) tags.Add($"SUSTAINED HITS {w.SustainedHits}");
        if (w.LethalHits) tags.Add("LETHAL HITS");
        if (w.DevastatingWounds) tags.Add("DEVASTATING WOUNDS");
        if (w.TwinLinked) tags.Add("TWIN-LINKED");
        if (w.IndirectFire) tags.Add("INDIRECT FIRE");
        if (w.Pistol) tags.Add("PISTOL");
        if (w.IgnoresCover) tags.Add("IGNORES COVER");
        if (w.Assault) tags.Add("ASSAULT");
        foreach (var (keyword, threshold) in w.Anti)
            tags.Add($"ANTI-{keyword.ToUpperInvariant()} {threshold}+");
        return tags;
    }
}
