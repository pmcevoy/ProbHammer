@page
@model LivePlayModel
@{
    ViewData["Title"] = "Live Play";
}

<main class="live-play-page">
    <partial name="_ArmyHeader" model="new ArmyHeaderRenderModel(Model.Header, Model.Glossary)"/>

    @for (var i = 0; i < Model.Units.Count; i++)
    {
        <partial name="_UnitBlock" model="new UnitBlockRenderModel(i, Model.Units[i], Model.Glossary)"/>
    }
</main>

@section Scripts {
    <script src="~/js/live-play.js" asp-append-version="true"></script>
}
