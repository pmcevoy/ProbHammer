@page
@model LivePlayModel
@using ProbHammer.Core.Domain.Catalogue
@{
    ViewData["Title"] = "Live Play";
}

<main class="live-play-page">
    <h1>Live Play</h1>

    @for (var i = 0; i < Model.Units.Count; i++)
    {
        var unit = Model.Units[i];
        <section class="unit-block">
            <h2>Unit @(i + 1)</h2>

            @if (unit.Statlines.Any())
            {
                <table class="statline-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>M</th>
                            <th>T</th>
                            <th>Sv</th>
                            <th>W</th>
                            <th>Ld</th>
                            <th>OC</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in unit.Statlines)
                        {
                            <tr>
                                <td class="statline-name">@row.Names</td>
                                <td>@(row.Statline.M)"</td>
                                <td>@row.Statline.T</td>
                                <td>@(row.Statline.Sv)+</td>
                                <td>@row.Statline.W</td>
                                <td>@row.Statline.Ld</td>
                                <td>@row.Statline.Oc</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (unit.Weapons.Any())
            {
                <table class="weapon-table">
                    <thead>
                        <tr>
                            <th>Weapon</th>
                            <th>Type</th>
                            <th>Rng</th>
                            <th>A</th>
                            <th>Skill</th>
                            <th>S</th>
                            <th>AP</th>
                            <th>D</th>
                            <th>Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in unit.Weapons)
                        {
                            var weapon = entry.Profile;
                            var rangeText = weapon.Type == WeaponType.Ranged ? $"{weapon.Range}\"" : "Melee";
                            <tr>
                                <td class="weapon-name">@weapon.Name</td>
                                <td>@weapon.Type</td>
                                <td>@rangeText</td>
                                <td>@weapon.A</td>
                                <td>@(weapon.Skill)+</td>
                                <td>@weapon.S</td>
                                <td>@weapon.Ap</td>
                                <td>@weapon.D</td>
                                <td>@entry.Count</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <div class="abilities-section">
                @if (unit.UnitScopedAbilities.Any())
                {
                    <details class="ability-block" open>
                        <summary>Unit Abilities</summary>
                        @foreach (var ability in unit.UnitScopedAbilities)
                        {
                            <p class="ability"><strong>@ability.Name:</strong> @ability.Text</p>
                        }
                    </details>
                }

                @foreach (var group in unit.ModelScopedAbilityGroups)
                {
                    <details class="ability-block">
                        <summary>@group.ModelLineLabel</summary>
                        @foreach (var ability in group.Abilities)
                        {
                            <p class="ability"><strong>@ability.Name:</strong> @ability.Text</p>
                        }
                    </details>
                }
            </div>

            @if (unit.Keywords.Any())
            {
                <div class="keywords">@string.Join(", ", unit.Keywords)</div>
            }
        </section>
    }
</main>
