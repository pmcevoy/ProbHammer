@model ProbHammer.Web.Pages.UnitBlockRenderModel
@using System.Net
@using ProbHammer.Core.Domain.Catalogue
@using ProbHammer.Core.Domain.Catalogue.Bsdata
@using ProbHammer.Web.Rendering
@{
    var unit = Model.Unit;
    var i = Model.UnitIndex;
    var glossary = Model.Glossary;

    // live-play-phase-tracker's own Expanded set for the current phase/turn selection - see
    // LivePlayModel.ExpandedSections. Null (a pre-existing call site that predates this feature)
    // defaults to "nothing expanded", matching this page's original unconditional-collapsed markup.
    var expandedSections = Model.ExpandedSections ?? new HashSet<UnitBlockSection>();

    // Popover trigger/panel building (ability names, resolvable weapon-keyword chips, and nested
    // [BRACKET] references reached from either one's own text) is extracted into RulePopoverRenderer
    // (design.md's "extract, don't duplicate" decision) so the header partial can produce the
    // identical markup with no unit page index to scope popover ids against - "u{i}" here matches
    // this unit block's own page index, "hdr" scopes the header's own instance.
    var popovers = new RulePopoverRenderer(glossary, $"u{i}");

    (string Trigger, string Trailer) BuildRulePopover(string triggerHtml, string triggerClass, string ruleText, IReadOnlySet<string> shownRuleNames) =>
        popovers.BuildRulePopover(triggerHtml, triggerClass, ruleText, shownRuleNames);
}
<section class="unit-block" data-unit-index="@i">
    <h2 class="unit-name">
        <span class="unit-name-text">@unit.Name</span>
    </h2>

    @* Unit status toolbar (consolidate-unit-toolbar): its own row between the unit-name header and
       the Statline section, immune to the header wrapping onto multiple lines for a long unit name
       (the reason the two status glyphs and the casualty-reset button used to live split across the
       header and the Statline summary bar). All three controls always render - no more
       hide-when-irrelevant per control. Each is a small square icon-button (.unit-toolbar-icon-btn,
       sized like .mod-step-btn/.casualty-btn's existing inc/dec controls) - the ONLY clickable
       area - with its plain-text caption (.unit-toolbar-label, styled like .stat-label) sitting
       beside it, outside the button, never part of the click target. Two independent states,
       purely via color: "actionable" (--bg3 background, clickable) vs. "inert" (--text-dim
       background, `disabled`) - see .unit-toolbar-icon-btn in site.css - and "active" (amber icon)
       vs. "inactive" (white icon), via .is-active. The caption's own color never changes with
       either state - it's a static label, not a status indicator. Each icon+label pair is grouped
       in its own .unit-toolbar-item, separated from its neighbor by a left border rather than a
       literal "|" character - a bordered cell, not a punctuation mark. *@
    <div class="unit-toolbar">
        @* Half-strength: a single-model unit (no computed determination is possible - see
           HalfStrengthResolution/domain-model-11e.md) is always actionable, toggling the
           player-set override; a multi-model unit is always inert (the computed determination is
           read-only) but its icon color still reflects that computed value - collapsed from the
           previous button-vs-span split into "always a button, permanently disabled" in this case,
           matching every other toolbar control's shape. *@
        @if (unit.IsSingleModelUnit)
        {
            <div class="unit-toolbar-item">
                <button type="button"
                        class="unit-toolbar-icon-btn status-glyph-halfstrength @(unit.IsAtOrBelowHalfStrength ? "is-active" : "")"
                        data-unit-index="@i" aria-pressed="@(unit.IsAtOrBelowHalfStrength ? "true" : "false")"
                        aria-label="Toggle at-or-below half strength" title="At or below half strength (tap to set)">½
                </button>
                <span class="unit-toolbar-label">Half Strength</span>
            </div>
        }
        else
        {
            <div class="unit-toolbar-item">
                <button type="button"
                        class="unit-toolbar-icon-btn status-glyph-halfstrength @(unit.IsAtOrBelowHalfStrength ? "is-active" : "")"
                        disabled
                        aria-label="At or below half strength (computed)" title="At or below half strength (computed)">½
                </button>
                <span class="unit-toolbar-label">Half Strength</span>
            </div>
        }
        @* Battle-shock: always present, always actionable - the app never simulates the
           2D6-vs-Leadership test itself, only records the player's own reported result. Icon color
           alone now carries active/inactive (see .unit-toolbar-icon-btn.is-active in site.css) -
           the bolt's old outline-vs-solid duality is no longer needed. *@
        <div class="unit-toolbar-item">
            <button type="button"
                    class="unit-toolbar-icon-btn status-glyph-battleshock @(unit.IsBattleShocked ? "is-active" : "")"
                    data-unit-index="@i" aria-pressed="@(unit.IsBattleShocked ? "true" : "false")"
                    aria-label="Toggle Battle-shocked" title="Battle-shocked (tap to set)">
                @Html.Raw(BoltSvgIcon("unit-toolbar-svg-icon"))
            </button>
            <span class="unit-toolbar-label">Battle-shock</span>
        </div>
        @* Reset Casualties: actionable only once there's something to reset - unlike the other two,
           it has no independent "active" fact, so its icon is amber exactly when actionable (see
           .is-active applied alongside `disabled` below, driven by the same HasCasualties check). *@
        <div class="unit-toolbar-item">
            <button type="button"
                    class="unit-toolbar-icon-btn casualty-reset-btn @(unit.HasCasualties ? "is-active" : "")"
                    disabled="@(!unit.HasCasualties)"
                    data-unit-index="@i"
                    aria-label="Reset casualties for this unit"
                    title="Reset casualties for this unit">@Html.Raw(SkullSvgIcon("unit-toolbar-svg-icon"))</button>
            <span class="unit-toolbar-label">Reset Casualties</span>
        </div>
    </div>

    @if (unit.Statlines.Any())
    {
        <details class="lp-section" data-section="statline" open="@(expandedSections.Contains(UnitBlockSection.Statline))">
            <summary>
                <span class="section-title">Statline</span>
                <span class="statline-flags">
                    <button type="button" class="filter-flag clear-filter-btn" hidden
                            aria-label="Filtered - click to clear" title="Filtered - click to clear">
                        <svg class="filter-flag-icon" viewBox="0 0 16 16" aria-hidden="true"><path
                                d="M1 2 L15 2 L10 8 L10 13 L6 15 L6 8 Z"/></svg>
                    </button>
                </span>
            </summary>
            @{
                // A deduplicated Core Rule ability (e.g. "Templar Vows") belongs to no single
                // component - it gets its own dedicated grid row above every component's own
                // rows, rather than spanning through them the way a component-wide ability does.
                // rowOffset shifts every other row down by one to make room for it; with none,
                // the grid is laid out exactly as before this change.
                var rowOffset = unit.WholeUnitAbilitySpans.Any() ? 1 : 0;
            }
            <div class="statline-grid">
                @foreach (var wholeUnitSpan in unit.WholeUnitAbilitySpans)
                {
                    var wholeUnitCollapsedClass = wholeUnitSpan.IsFullyDead ? "run-collapsed" : "";
                    var wholeUnitDeadAttr = wholeUnitSpan.IsFullyDead ? "true" : "false";
                    @if (wholeUnitSpan.ModelAbilities.Any())
                    {
                        <div class="statline-cell col-model-abilities spans-whole-unit @wholeUnitCollapsedClass"
                             data-dead="@wholeUnitDeadAttr" style="grid-row: 1; grid-column: 2;">
                            @foreach (var ability in wholeUnitSpan.ModelAbilities)
                            {
                                var (abilityTrigger, abilityTrailer) = BuildRulePopover(WebUtility.HtmlEncode(AbilityDisplayName(ability)), "ability-name-line", ability.Text, new HashSet<string>());
                                @Html.Raw(abilityTrigger)
                                @Html.Raw(abilityTrailer)
                            }
                        </div>
                    }

                    @if (wholeUnitSpan.UnitAbilities.Any())
                    {
                        <div class="statline-cell col-unit-abilities spans-whole-unit @wholeUnitCollapsedClass"
                             data-dead="@wholeUnitDeadAttr" style="grid-row: 1; grid-column: 3;">
                            @foreach (var ability in wholeUnitSpan.UnitAbilities)
                            {
                                var (abilityTrigger, abilityTrailer) = BuildRulePopover(WebUtility.HtmlEncode(AbilityDisplayName(ability)), "ability-name-line", ability.Text, new HashSet<string>());
                                @Html.Raw(abilityTrigger)
                                @Html.Raw(abilityTrailer)
                            }
                        </div>
                    }
                }
                @for (var runIndex = 0; runIndex < unit.Statlines.Count; runIndex++)
                {
                    var block = unit.Statlines[runIndex];
                    var runCollapsedClass = block.IsFullyDead ? "run-collapsed" : "";
                    var runDeadAttr = block.IsFullyDead ? "true" : "false";
                    <div class="statline-cell col-statline @runCollapsedClass" data-run-index="@runIndex"
                         data-dead="@runDeadAttr" style="grid-row: @(runIndex + 1 + rowOffset); grid-column: 1;">
                        @for (var entryIndex = 0; entryIndex < block.Entries.Count; entryIndex++)
                        {
                            var entry = block.Entries[entryIndex];
                            var multiLoadout = entry.Loadouts.Count > 1;
                            <div class="statline-entry">
                                @if (multiLoadout)
                                {
                                    var entryDeadClass = entry.RemainingCount == 0 ? "entry-dead" : "";
                                    <div class="statline-header statline-toggle-group @entryDeadClass">
                                        <span class="select-indicator" aria-hidden="true"></span>
                                        <span class="statline-name">@entry.StatlineName</span>
                                        <span
                                            class="statline-count">(@(entry.RemainingCount)/@(entry.InitialCount))</span>
                                    </div>
                                    var loadoutLabels = block.LoadoutLabels[entryIndex];
                                    <ul class="loadout-breakdown">
                                        @for (var loadoutIndex = 0; loadoutIndex < entry.Loadouts.Count; loadoutIndex++)
                                        {
                                            var loadout = entry.Loadouts[loadoutIndex];
                                            var loadoutCasualtyKey = LivePlayModel.CasualtyKey(i, entry.ComponentName, entry.StatlineName, loadoutIndex);
                                            var loadoutDeadClass = loadout.RemainingCount == 0 ? "loadout-dead" : "";
                                            <li class="loadout-toggle @loadoutDeadClass"
                                                data-select-key="@LivePlayModel.SelectKey(entry.ComponentName, entry.StatlineName, loadoutIndex)">
                                                <span class="select-indicator" aria-hidden="true"></span>
                                                <span class="loadout-label">@loadoutLabels[loadoutIndex]</span>
                                                (@(loadout.RemainingCount)/@(loadout.InitialCount))
                                                <span class="casualty-controls">
                                                    <button type="button" class="casualty-btn mod-step-btn casualty-dec"
                                                            data-casualty-key="@loadoutCasualtyKey"
                                                            data-remaining="@loadout.RemainingCount"
                                                            data-initial="@loadout.InitialCount"
                                                            aria-label="Mark casualty"
                                                            disabled="@(loadout.RemainingCount == 0)">&minus;</button>
                                                    <button type="button" class="casualty-btn mod-step-btn casualty-inc"
                                                            data-casualty-key="@loadoutCasualtyKey"
                                                            data-remaining="@loadout.RemainingCount"
                                                            data-initial="@loadout.InitialCount"
                                                            aria-label="Restore model"
                                                            disabled="@(loadout.RemainingCount == loadout.InitialCount)">+</button>
                                                </span>
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    var entryCasualtyKey = LivePlayModel.CasualtyKey(i, entry.ComponentName, entry.StatlineName, -1);
                                    var entryDeadClass = entry.RemainingCount == 0 ? "entry-dead" : "";
                                    <div class="statline-header statline-toggle @entryDeadClass"
                                         data-select-key="@LivePlayModel.SelectKey(entry.ComponentName, entry.StatlineName, -1)">
                                        <span class="select-indicator" aria-hidden="true"></span>
                                        <span class="statline-name">@entry.StatlineName</span>
                                        <span
                                            class="statline-count">(@(entry.RemainingCount)/@(entry.InitialCount))</span>
                                        <span class="casualty-controls">
                                            <button type="button" class="casualty-btn mod-step-btn casualty-dec"
                                                    data-casualty-key="@entryCasualtyKey"
                                                    data-remaining="@entry.RemainingCount"
                                                    data-initial="@entry.InitialCount" aria-label="Mark casualty"
                                                    disabled="@(entry.RemainingCount == 0)">&minus;</button>
                                            <button type="button" class="casualty-btn mod-step-btn casualty-inc"
                                                    data-casualty-key="@entryCasualtyKey"
                                                    data-remaining="@entry.RemainingCount"
                                                    data-initial="@entry.InitialCount" aria-label="Restore model"
                                                    disabled="@(entry.RemainingCount == entry.InitialCount)">+</button>
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                        <div class="statline-tiles">
                            <div class="stat-tile"><span class="stat-label">M</span><span
                                    class="stat-value">@(block.Statline.M)"</span></div>
                            <div class="stat-tile"><span class="stat-label">T</span><span
                                    class="stat-value">@(block.Statline.T)</span></div>
                            <div class="stat-tile"><span class="stat-label">Sv</span><span
                                    class="stat-value">@(block.Statline.Sv)+</span></div>
                            <div class="stat-tile"><span class="stat-label">W</span><span
                                    class="stat-value">@(block.Statline.W)</span></div>
                            <div class="stat-tile"><span class="stat-label">Ld</span><span
                                    class="stat-value">@(block.Statline.Ld)+</span></div>
                            @* Battle-shocked: OC renders the same glyph as the header's Battle-shock
                               control, in the tile's own value color (never amber - see
                               design-tokens.md's "controls get amber ink when active, stat values
                               never do") - the "flagged" signal lives entirely in the tile's
                               background (.stat-tile-flagged, shared with the caveated-InSv tile
                               below), not in the glyph's own color. No label change, no caption
                               text: unlike a caveated InSv, there's only one fixed reason, already
                               conveyed by the header glyph. Applies to every run's OC tile in this
                               unit, not only whichever run the header itself sits above - Battle-
                               shocked is one flag for the whole unit (see
                               attached-unit-tracker's Battle-Shocked Status Is Player-Set
                               requirement). *@
                            @if (unit.IsBattleShocked)
                            {
                                <div class="stat-tile stat-tile-flagged"><span class="stat-label">OC</span><span
                                        class="stat-value">@Html.Raw(BoltSvgIcon("oc-battleshock-icon"))</span></div>
                            }
                            else if (block.ObjectiveControlMarker is { } ocMarker)
                            {
                                <div class="stat-tile stat-tile-flagged"><span
                                        class="stat-label">OC@(ocMarker)</span><span
                                        class="stat-value">@(block.Statline.Oc)</span></div>
                            }
                            else
                            {
                                <div class="stat-tile"><span class="stat-label">OC</span><span
                                        class="stat-value">@(block.Statline.Oc)</span></div>
                            }
                            @{
                                var inv = block.Statline.InSv;
                            }
                            @* The invulnerable save renders as its own labeled box below the row, GW/Wahapedia-card
                               style, rather than a value stacked inside the Sv tile. The caveated branch is the only
                               place in this file that renders an Ability's Text rather than only its Name - see
                               `redesign-invulnerable-save-display`'s design.md; this is a scoped exception to the
                               page's otherwise name-only ability rendering, not a step toward rendering text
                               generally, since only this one condition has no other way to be shown to the player. *@
                            @{
                                // Melee reads fine as the plain Unicode glyph (text-presentation by default, so it
                                // inherits currentColor); Ranged does not - every text-glyph candidate tried live
                                // (⌖, ◎, ⊙) rendered ambiguously in this browser/OS font stack (a diamond, an "info"
                                // icon, a bullet), so Ranged is a small inline SVG crosshair instead, matching this
                                // file's existing filter-flag icon precedent for exactly the same reason.
                                var rangedIcon = "<svg class=\"insv-icon\" viewBox=\"0 0 16 16\" aria-hidden=\"true\">" +
                                                 "<circle cx=\"8\" cy=\"8\" r=\"5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" />" +
                                                 "<line x1=\"8\" y1=\"0\" x2=\"8\" y2=\"3\" stroke=\"currentColor\" stroke-width=\"1.5\" />" +
                                                 "<line x1=\"8\" y1=\"13\" x2=\"8\" y2=\"16\" stroke=\"currentColor\" stroke-width=\"1.5\" />" +
                                                 "<line x1=\"0\" y1=\"8\" x2=\"3\" y2=\"8\" stroke=\"currentColor\" stroke-width=\"1.5\" />" +
                                                 "<line x1=\"13\" y1=\"8\" x2=\"16\" y2=\"8\" stroke=\"currentColor\" stroke-width=\"1.5\" />" +
                                                 "</svg>";
                            }
                            @* The InSv box is a .stat-tile like M/T/Sv/W/Ld/Oc (label on top, value below, inside
                               one bordered box), not a separate box+label pair beside each other - matches the
                               other Statline attributes' own layout exactly, per direct user feedback. Any
                               attack-type icon rides inside the value line itself (next to the number it
                               qualifies), not the label - the label is always just "InSv", plus
                               block.InvulnerableSaveMarker when this run's save is flagged (still-caveated, or
                               resolved by a matched statline-flag-rules rule) across every shape. *@
                            @{
                                var insvLabel = "InSv" + block.InvulnerableSaveMarker;
                            }
                            @if (inv.Caveated)
                            {
                                <div class="stat-tile insv-tile stat-tile-flagged">
                                    <span class="stat-label">@insvLabel</span>
                                    <span class="stat-value">@(inv.MeleeInSv)+</span>
                                </div>
                            }
                            else if (inv.MeleeInSv == 0 && inv.RangedInSv == 0)
                            {
                                @* Absent - no invulnerable save box at all. *@
                            }
                            else if (inv.MeleeInSv == inv.RangedInSv)
                            {
                                @* Uniform - applies equally to both attack types, so no attack-type icon needed. *@
                                <div
                                    class="stat-tile insv-tile @(block.InvulnerableSaveMarker != null ? "stat-tile-flagged" : "")">
                                    <span class="stat-label">@insvLabel</span>
                                    <span class="stat-value">@(inv.MeleeInSv)+</span>
                                </div>
                            }
                            else if (inv.RangedInSv == 0)
                            {
                                <div
                                    class="stat-tile insv-tile @(block.InvulnerableSaveMarker != null ? "stat-tile-flagged" : "")">
                                    <span class="stat-label">@insvLabel</span>
                                    <span class="stat-value">⚔ @(inv.MeleeInSv)+</span>
                                </div>
                            }
                            else if (inv.MeleeInSv == 0)
                            {
                                <div
                                    class="stat-tile insv-tile @(block.InvulnerableSaveMarker != null ? "stat-tile-flagged" : "")">
                                    <span class="stat-label">@insvLabel</span>
                                    <span class="stat-value">@Html.Raw(rangedIcon) @(inv.RangedInSv)+</span>
                                </div>
                            }
                            else
                            {
                                @* Two stacked rows (ranged above melee), not one line with a "/" separator - each
                                   row reads as a complete, self-contained fact ("ranged: 5+", "melee: 4+") rather
                                   than needing the eye to track a column pairing across a divider. *@
                                <div
                                    class="stat-tile insv-tile @(block.InvulnerableSaveMarker != null ? "stat-tile-flagged" : "")">
                                    <span class="stat-label">@insvLabel</span>
                                    <span class="stat-value stat-value-compact">
                                        <span>@Html.Raw(rangedIcon) @(inv.RangedInSv)+</span>
                                        <span>⚔ @(inv.MeleeInSv)+</span>
                                    </span>
                                </div>
                            }
                        </div>
                        @if (block.FlagLegend.Count > 0)
                        {
                            <div class="statline-flag-legend">
                                @foreach (var flag in block.FlagLegend)
                                {
                                    var legendTriggerHtml = WebUtility.HtmlEncode($"{flag.Marker} {AbilityDisplayName(flag.Source)}");
                                    var (legendTrigger, legendTrailer) = BuildRulePopover(legendTriggerHtml, "ability-name-line flag-legend-line", flag.Source.Text, new HashSet<string>());
                                    @Html.Raw(legendTrigger)
                                    @Html.Raw(legendTrailer)
                                }
                            </div>
                        }
                    </div>

                    @if (block.ModelAbilities.Any())
                    {
                        <div class="statline-cell col-model-abilities @runCollapsedClass" data-run-index="@runIndex"
                             data-dead="@runDeadAttr" style="grid-row: @(runIndex + 1 + rowOffset); grid-column: 2;">
                            @foreach (var ability in block.ModelAbilities)
                            {
                                var (abilityTrigger, abilityTrailer) = BuildRulePopover(WebUtility.HtmlEncode(AbilityDisplayName(ability)), "ability-name-line", ability.Text, new HashSet<string>());
                                @Html.Raw(abilityTrigger)
                                @Html.Raw(abilityTrailer)
                            }
                        </div>
                    }

                    @if (block.UnitAbilities.Any())
                    {
                        <div class="statline-cell col-unit-abilities @runCollapsedClass" data-run-index="@runIndex"
                             data-dead="@runDeadAttr" style="grid-row: @(runIndex + 1 + rowOffset); grid-column: 3;">
                            @foreach (var ability in block.UnitAbilities)
                            {
                                var (abilityTrigger, abilityTrailer) = BuildRulePopover(WebUtility.HtmlEncode(AbilityDisplayName(ability)), "ability-name-line", ability.Text, new HashSet<string>());
                                @Html.Raw(abilityTrigger)
                                @Html.Raw(abilityTrailer)
                            }
                        </div>
                    }
                }

                @foreach (var span in unit.ComponentAbilitySpans)
                {
                    var spanCollapsedClass = span.IsFullyDead ? "run-collapsed" : "";
                    var spanDeadAttr = span.IsFullyDead ? "true" : "false";
                    @if (span.ModelAbilities.Any())
                    {
                        <div class="statline-cell col-model-abilities spans-component @spanCollapsedClass"
                             data-first-run-index="@(span.FirstRunIndex)" data-last-run-index="@(span.LastRunIndex)"
                             data-dead="@spanDeadAttr"
                             style="grid-row: @(span.FirstRunIndex + 1 + rowOffset) / @(span.LastRunIndex + 2 + rowOffset); grid-column: 2;">
                            @foreach (var ability in span.ModelAbilities)
                            {
                                var (abilityTrigger, abilityTrailer) = BuildRulePopover(WebUtility.HtmlEncode(AbilityDisplayName(ability)), "ability-name-line", ability.Text, new HashSet<string>());
                                @Html.Raw(abilityTrigger)
                                @Html.Raw(abilityTrailer)
                            }
                        </div>
                    }

                    @if (span.UnitAbilities.Any())
                    {
                        <div class="statline-cell col-unit-abilities spans-component @spanCollapsedClass"
                             data-first-run-index="@(span.FirstRunIndex)" data-last-run-index="@(span.LastRunIndex)"
                             data-dead="@spanDeadAttr"
                             style="grid-row: @(span.FirstRunIndex + 1 + rowOffset) / @(span.LastRunIndex + 2 + rowOffset); grid-column: 3;">
                            @foreach (var ability in span.UnitAbilities)
                            {
                                var (abilityTrigger, abilityTrailer) = BuildRulePopover(WebUtility.HtmlEncode(AbilityDisplayName(ability)), "ability-name-line", ability.Text, new HashSet<string>());
                                @Html.Raw(abilityTrigger)
                                @Html.Raw(abilityTrailer)
                            }
                        </div>
                    }
                }
            </div>
        </details>
    }

    @if (unit.RangedWeapons.Any())
    {
        <details class="lp-section" data-section="ranged" open="@(expandedSections.Contains(UnitBlockSection.Ranged))">
            <summary>
                <span class="section-title">Ranged Weapons</span>
                <span class="filter-flag filtered-badge" hidden aria-label="Filtered" title="Filtered">
                    <svg class="filter-flag-icon" viewBox="0 0 16 16" aria-hidden="true"><path
                            d="M1 2 L15 2 L10 8 L10 13 L6 15 L6 8 Z"/></svg>
                </span>
            </summary>
            <table class="weapon-table">
                <colgroup>
                    <col class="col-weapon"/>
                    <col class="col-slot"/>
                    <col class="col-slot"/>
                    <col class="col-slot"/>
                    <col class="col-slot"/>
                    <col class="col-slot"/>
                    <col class="col-slot"/>
                </colgroup>
                <thead>
                <tr>
                    <th>Weapon</th>
                    <th>Rng</th>
                    <th>A</th>
                    <th>BS</th>
                    <th>S</th>
                    <th>AP</th>
                    <th>D</th>
                </tr>
                </thead>
                <tbody>
                @for (var w = 0; w < unit.RangedWeapons.Count; w++)
                {
                    var row = unit.RangedWeapons[w];
                    var weapon = row.Entry.Profile;
                    var tags = WeaponAbilityTags(weapon);
                    var weaponId = $"w-{i}-r-{w}";
                    <tr class="@(w % 2 == 1 ? "weapon-row-alt" : "")" data-weapon-id="@weaponId">
                        <td class="weapon-name">
                            @if (row.ShowsBreakdownTrigger)
                            {
                                <button type="button" class="weapon-name-toggle" data-weapon-id="@weaponId"
                                        aria-expanded="false">
                                    @weapon.Name
                                </button>
                            }
                            else
                            {
                                @weapon.Name
                            }
                            @if (tags.Count > 0)
                            {
                                <div class="weapon-tags">
                                    @foreach (var tag in tags)
                                    {
                                        var rule = glossary.TryResolve(tag);
                                        if (rule != null)
                                        {
                                            var (tagTrigger, tagTrailer) = BuildRulePopover(WebUtility.HtmlEncode(tag), "weapon-tag weapon-tag-resolved", rule.Text, new HashSet<string> { rule.Name });
                                            @Html.Raw(tagTrigger)
                                            @Html.Raw(tagTrailer)
                                        }
                                        else
                                        {
                                            <span class="weapon-tag weapon-tag-unresolved">@tag</span>
                                        }
                                    }
                                </div>
                            }
                        </td>
                        <td>@(weapon.Range)"</td>
                        <td class="weapon-attacks-value">@row.Entry.TotalAttacks</td>
                        <td>@(weapon.Skill)+</td>
                        <td>@weapon.S</td>
                        <td>@weapon.Ap</td>
                        <td>@weapon.D</td>
                    </tr>
                    @foreach (var breakdown in row.Breakdown)
                    {
                        <tr class="weapon-contribution-row @(breakdown.SelectKey == null ? "contribution-merged" : "") @(w % 2 == 1 ? "weapon-row-alt" : "")"
                            data-weapon-id="@weaponId" data-group-key="@breakdown.GroupKey"
                            data-merged="@(breakdown.SelectKey == null ? "true" : "false")"
                            data-select-key="@breakdown.SelectKey" data-subtotal-value="@breakdown.SubtotalValue"
                            hidden>
                            <td class="weapon-contribution-label">@breakdown.Label (@(breakdown.Count)&times;@(breakdown.PerModelAttacks))</td>
                            <td></td>
                            <td>@breakdown.Subtotal</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </details>
    }

    @if (unit.MeleeWeapons.Any())
    {
        <details class="lp-section" data-section="melee" open="@(expandedSections.Contains(UnitBlockSection.Melee))">
            <summary>
                <span class="section-title">Melee Weapons</span>
                <span class="filter-flag filtered-badge" hidden aria-label="Filtered" title="Filtered">
                    <svg class="filter-flag-icon" viewBox="0 0 16 16" aria-hidden="true"><path
                            d="M1 2 L15 2 L10 8 L10 13 L6 15 L6 8 Z"/></svg>
                </span>
            </summary>
            <table class="weapon-table">
                <colgroup>
                    <col class="col-weapon-melee"/>
                    <col class="col-slot"/>
                    <col class="col-slot"/>
                    <col class="col-slot"/>
                    <col class="col-slot"/>
                    <col class="col-slot"/>
                </colgroup>
                <thead>
                <tr>
                    <th>Weapon</th>
                    <th>A</th>
                    <th>WS</th>
                    <th>S</th>
                    <th>AP</th>
                    <th>D</th>
                </tr>
                </thead>
                <tbody>
                @for (var w = 0; w < unit.MeleeWeapons.Count; w++)
                {
                    var row = unit.MeleeWeapons[w];
                    var weapon = row.Entry.Profile;
                    var tags = WeaponAbilityTags(weapon);
                    var weaponId = $"w-{i}-m-{w}";
                    <tr class="@(w % 2 == 1 ? "weapon-row-alt" : "")" data-weapon-id="@weaponId">
                        <td class="weapon-name">
                            @if (row.ShowsBreakdownTrigger)
                            {
                                <button type="button" class="weapon-name-toggle" data-weapon-id="@weaponId"
                                        aria-expanded="false">
                                    @weapon.Name
                                </button>
                            }
                            else
                            {
                                @weapon.Name
                            }
                            @if (tags.Count > 0)
                            {
                                <div class="weapon-tags">
                                    @foreach (var tag in tags)
                                    {
                                        var rule = glossary.TryResolve(tag);
                                        if (rule != null)
                                        {
                                            var (tagTrigger, tagTrailer) = BuildRulePopover(WebUtility.HtmlEncode(tag), "weapon-tag weapon-tag-resolved", rule.Text, new HashSet<string> { rule.Name });
                                            @Html.Raw(tagTrigger)
                                            @Html.Raw(tagTrailer)
                                        }
                                        else
                                        {
                                            <span class="weapon-tag weapon-tag-unresolved">@tag</span>
                                        }
                                    }
                                </div>
                            }
                        </td>
                        <td class="weapon-attacks-value">@row.Entry.TotalAttacks</td>
                        <td>@(weapon.Skill)+</td>
                        <td>@weapon.S</td>
                        <td>@weapon.Ap</td>
                        <td>@weapon.D</td>
                    </tr>
                    @foreach (var breakdown in row.Breakdown)
                    {
                        <tr class="weapon-contribution-row @(breakdown.SelectKey == null ? "contribution-merged" : "") @(w % 2 == 1 ? "weapon-row-alt" : "")"
                            data-weapon-id="@weaponId" data-group-key="@breakdown.GroupKey"
                            data-merged="@(breakdown.SelectKey == null ? "true" : "false")"
                            data-select-key="@breakdown.SelectKey" data-subtotal-value="@breakdown.SubtotalValue"
                            hidden>
                            <td class="weapon-contribution-label">@breakdown.Label (@(breakdown.Count)&times;@(breakdown.PerModelAttacks))</td>
                            <td>@breakdown.Subtotal</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </details>
    }

    @if (unit.Keywords.Any())
    {
        <details class="lp-section" data-section="keywords" open="@(expandedSections.Contains(UnitBlockSection.Keywords))">
            <summary>
                <span class="section-title">Keywords</span>
            </summary>
            <div class="weapon-tags">
                @foreach (var keyword in unit.Keywords)
                {
                    <span class="weapon-tag">@keyword</span>
                }
            </div>
        </details>
    }
</section>

@functions {

    static string AbilityDisplayName(Ability ability) =>
        ability.Origin == AbilityOrigin.Enhancement ? $"✦ {ability.Name}" : ability.Name;

    // Shared lightning-bolt shape for both the Battle-shock toolbar control and a Battle-shocked
    // unit's OC tile - "the same glyph", per half-strength-and-battleshock-indicators' spec, not
    // two independently-drawn bolts that only coincidentally look similar. Inline SVG rather than a
    // Unicode/emoji character, matching .filter-flag-icon's own precedent - fill resolves from
    // currentColor, so the same markup paints white/--amber (toolbar) or the tile's own
    // .stat-value color (OC tile) purely via CSS, with no markup variation needed.
    static string BoltSvgIcon(string cssClass) =>
        $"<svg class=\"{cssClass}\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M9 1 L3 9 L7 9 L6 15 L13 6 L9 6 Z\" /></svg>";

    // Reset Casualties' skull, inline SVG rather than the U+1F480 emoji character this button used
    // before consolidate-unit-toolbar's restyle - found, via direct user testing, to be the reason
    // the icon never actually turned amber when active: most platforms render an emoji as a fixed,
    // full-color glyph that ignores `color`/`currentColor` entirely, the same class of problem
    // BoltSvgIcon above was already built to avoid. fill-rule="evenodd" carves the eye sockets and
    // nasal cavity as true holes (through to whatever's behind the icon - the button's own current
    // background) out of one filled silhouette, rather than layering same-colored shapes that would
    // just blend into a solid blob.
    static string SkullSvgIcon(string cssClass) =>
        $"<svg class=\"{cssClass}\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path fill-rule=\"evenodd\" d=\"M8,1 C4.7,1 2,3.6 2,6.8 C2,8.7 3,10.3 4.5,11.3 L4.5,13 C4.5,13.6 5,14 5.5,14 L10.5,14 C11,14 11.5,13.6 11.5,13 L11.5,11.3 C13,10.3 14,8.7 14,6.8 C14,3.6 11.3,1 8,1 Z M7,6.7 A1.3,1.3 0 1,0 4.4,6.7 A1.3,1.3 0 1,0 7,6.7 Z M11.6,6.7 A1.3,1.3 0 1,0 9,6.7 A1.3,1.3 0 1,0 11.6,6.7 Z M7.4,7.6 L8.6,7.6 L8,9 Z\" /></svg>";

    static List<string> WeaponAbilityTags(WeaponProfile w)
    {
        var tags = new List<string>();
        if (w.Torrent) tags.Add("TORRENT");
        if (w.Blast) tags.Add("BLAST");
        if (w.Melta > 0) tags.Add($"MELTA {w.Melta}");
        if (w.RapidFire > 0) tags.Add($"RAPID FIRE {w.RapidFire}");
        if (w.SustainedHits > 0) tags.Add($"SUSTAINED HITS {w.SustainedHits}");
        if (w.LethalHits) tags.Add("LETHAL HITS");
        if (w.DevastatingWounds) tags.Add("DEVASTATING WOUNDS");
        if (w.TwinLinked) tags.Add("TWIN-LINKED");
        if (w.IndirectFire) tags.Add("INDIRECT FIRE");
        if (w.Pistol) tags.Add("PISTOL");
        if (w.IgnoresCover) tags.Add("IGNORES COVER");
        if (w.Assault) tags.Add("ASSAULT");
        foreach (var (keyword, threshold) in w.Anti)
            tags.Add($"ANTI-{keyword.ToUpperInvariant()} {threshold}+");
        return tags;
    }

}
