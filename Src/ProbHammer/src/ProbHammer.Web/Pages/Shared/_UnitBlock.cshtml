                                        if (rule != null)
                                        {
                                            var (tagTrigger, tagTrailer) = BuildRulePopover(WebUtility.HtmlEncode(tag), "weapon-tag weapon-tag-resolved", rule.Text, new HashSet<string> { rule.Name });
                                            @Html.Raw(tagTrigger)
                                            @Html.Raw(tagTrailer)
                                        }
                                        else
