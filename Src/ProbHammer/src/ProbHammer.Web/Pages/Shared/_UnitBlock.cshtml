@functions {

    static string AbilityDisplayName(Ability ability) =>
        ability.Origin == AbilityOrigin.Enhancement ? $"✦ {ability.Name}" : ability.Name;

    // The weapon-table counterpart to RenderScalarTile below - marks the value cell itself rather
    // than a label, since the weapon table has no per-characteristic label the way a Statline tile
    // does (render-weapon-characteristic-effects). Unlike RenderScalarTile, no IsCaveated guard is
    // needed: a WeaponProfile's S/AP/D never starts caveated (see WeaponCharacteristicEffectResolver's
    // own doc comment), so a populated marker here always means a genuinely resolved mutation.
    static string RenderWeaponValueCell(WeaponRowViewModel row, string field, string suffix)
    {
        var view = LivePlayModel.GetWeaponScalarField(row.Entry.Profile, field);
        var marker = row.ValueMarker(field);
        var cssClass = marker is not null ? "weapon-value-flagged" : "";
        var valueText = WebUtility.HtmlEncode($"{view.Value}{marker}{suffix}");
        return $"<td class=\"{cssClass}\">{valueText}</td>";
    }

    // Shared renderer for the five ScalarCharacteristicView-backed statline tiles other than OC
    // (which keeps its own bespoke branch for the Battle-shocked override). Covers
    // M/T/Sv/W/Ld uniformly: `fieldKey` is the LivePlayModel.GetScalarField-recognized name
    // ("M"/"T"/"Sv"/"W"/"LD"), `label` is the display text a flagged run's own marker gets
    // appended to, `suffix` is the literal trailing text (`"`/`+`/none) each characteristic's own
    // printed convention uses.
    //
    // The amber .stat-tile-flagged background is reserved for a RESOLVED (non-caveated) run - one
    // whose displayed value is an actual DerivedValue the app computed, not the plain catalogue
    // Value shown while still caveated. The marker itself (and the legend line it points to) still renders
    // either way - amber specifically means "this number has already been adjusted for you," which
    // a still-caveated tile hasn't been; painting it amber would wrongly suggest the shown value
    // already accounts for the linked ability, per direct user feedback reviewing a real caveated
    // "Auric Mantle" W tile live.
    static string RenderScalarTile(string label, string fieldKey, StatlineBlockViewModel block, string suffix)
    {
        var view = LivePlayModel.GetScalarField(block.Statline, fieldKey);
        var marker = block.ScalarMarker(fieldKey);
        var cssClass = marker is not null && !view.IsCaveated ? "stat-tile stat-tile-flagged" : "stat-tile";
        var labelText = WebUtility.HtmlEncode(marker is null ? label : $"{label}{marker}");
        var valueText = WebUtility.HtmlEncode(view.Value.ToString());
        return $"<div class=\"{cssClass}\"><span class=\"stat-label\">{labelText}</span>" +
               $"<span class=\"stat-value\">{valueText}{suffix}</span></div>";
    }

    // Shared lightning-bolt shape for both the Battle-shock toolbar control and a Battle-shocked
    // unit's OC tile - the same glyph, not
    // two independently-drawn bolts that only coincidentally look similar. Inline SVG rather than a
    // Unicode/emoji character, matching .filter-flag-icon's own precedent - fill resolves from
    // currentColor, so the same markup paints white/--amber (toolbar) or the tile's own
    // .stat-value color (OC tile) purely via CSS, with no markup variation needed.
    static string BoltSvgIcon(string cssClass) =>
        $"<svg class=\"{cssClass}\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M9 1 L3 9 L7 9 L6 15 L13 6 L9 6 Z\" /></svg>";

    // Reset Casualties' skull, inline SVG rather than the U+1F480 emoji character: most platforms
    // render an emoji as a fixed, full-color glyph that ignores `color`/`currentColor` entirely,
    // which would keep the icon from ever turning amber when active - the same class of problem
    // BoltSvgIcon above was already built to avoid. fill-rule="evenodd" carves the eye sockets and
    // nasal cavity as true holes (through to whatever's behind the icon - the button's own current
    // background) out of one filled silhouette, rather than layering same-colored shapes that would
    // just blend into a solid blob.
    static string SkullSvgIcon(string cssClass) =>
        $"<svg class=\"{cssClass}\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path fill-rule=\"evenodd\" d=\"M8,1 C4.7,1 2,3.6 2,6.8 C2,8.7 3,10.3 4.5,11.3 L4.5,13 C4.5,13.6 5,14 5.5,14 L10.5,14 C11,14 11.5,13.6 11.5,13 L11.5,11.3 C13,10.3 14,8.7 14,6.8 C14,3.6 11.3,1 8,1 Z M7,6.7 A1.3,1.3 0 1,0 4.4,6.7 A1.3,1.3 0 1,0 7,6.7 Z M11.6,6.7 A1.3,1.3 0 1,0 9,6.7 A1.3,1.3 0 1,0 11.6,6.7 Z M7.4,7.6 L8.6,7.6 L8,9 Z\" /></svg>";

    static List<string> WeaponAbilityTags(WeaponProfile w)
    {
        var tags = new List<string>();
        if (w.Torrent) tags.Add("TORRENT");
        if (w.Blast) tags.Add("BLAST");
        if (w.Melta > 0) tags.Add($"MELTA {w.Melta}");
        if (w.RapidFire > 0) tags.Add($"RAPID FIRE {w.RapidFire}");
        if (w.SustainedHits > 0) tags.Add($"SUSTAINED HITS {w.SustainedHits}");
        if (w.LethalHits) tags.Add("LETHAL HITS");
        if (w.DevastatingWounds) tags.Add("DEVASTATING WOUNDS");
        if (w.TwinLinked) tags.Add("TWIN-LINKED");
        if (w.IndirectFire) tags.Add("INDIRECT FIRE");
        if (w.Pistol) tags.Add("PISTOL");
        if (w.IgnoresCover) tags.Add("IGNORES COVER");
        if (w.Assault) tags.Add("ASSAULT");
        foreach (var (keyword, threshold) in w.Anti)
            tags.Add($"ANTI-{keyword.ToUpperInvariant()} {threshold}+");
        return tags;
    }

}
