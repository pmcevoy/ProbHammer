    @if (unit.MeleeWeapons.Any())
    {
        <details class="lp-section" data-section="melee" open="@(expandedSections.Contains(UnitBlockSection.Melee))">
            <summary>
                <span class="section-title">Melee Weapons</span>
                <span class="filter-flag filtered-badge" hidden aria-label="Filtered" title="Filtered">
                    <svg class="filter-flag-icon" viewBox="0 0 16 16" aria-hidden="true"><path
                            d="M1 2 L15 2 L10 8 L10 13 L6 15 L6 8 Z"/></svg>
                </span>
            </summary>
            <table class="weapon-table">
                <colgroup>
                    <col class="col-weapon-melee"/>
                    <col class="col-slot"/>
                    <col class="col-slot"/>
                    <col class="col-slot"/>
                    <col class="col-slot"/>
                    <col class="col-slot"/>
                </colgroup>
                <thead>
                <tr>
                    <th>Weapon</th>
                    <th>A</th>
                    <th>WS</th>
                    <th>S</th>
                    <th>AP</th>
                    <th>D</th>
                </tr>
                </thead>
                <tbody>
                @for (var w = 0; w < unit.MeleeWeapons.Count; w++)
                {
                    var row = unit.MeleeWeapons[w];
                    var weapon = row.Entry.Profile;
                    var weaponId = $"w-{i}-m-{w}";
                    var nameLabel = row.Entry.Name;
                    <tr class="@(w % 2 == 1 ? "weapon-row-alt" : "")" data-weapon-id="@weaponId">
                        <td class="weapon-name">
                            @if (row.ShowsBreakdownTrigger)
                            {
                                <button type="button" class="weapon-name-toggle" data-weapon-id="@weaponId"
                                        aria-expanded="false">
                                    @nameLabel
                                </button>
                            }
                            else
                            {
                                @nameLabel
                            }
                            @if (row.Chips.Count > 0)
                            {
                                <div class="weapon-tags">
                                    @foreach (var chip in row.Chips)
                                    {
                                        var tag = chip.Text;
                                        var rule = glossary.TryResolve(tag);
                                        if (chip.Kind != ChipKind.Native)
                                        {
                                            var (chipTrigger, chipTrailer) = popovers.BuildKeywordChipPopover(chip,
                                                chip.Kind == ChipKind.Granted ? "weapon-tag weapon-tag-granted" : "weapon-tag weapon-tag-cond", rule);
                                            @Html.Raw(chipTrigger)
                                            @Html.Raw(chipTrailer)
                                        }
                                        else if (rule != null)
                                        {
                                            var (tagTrigger, tagTrailer) = BuildRulePopover(WebUtility.HtmlEncode(tag), "weapon-tag weapon-tag-resolved", rule.Text, new HashSet<string> { rule.Name });
                                            @Html.Raw(tagTrigger)
                                            @Html.Raw(tagTrailer)
                                        }
                                        else
                                        {
                                            <span class="weapon-tag weapon-tag-unresolved">@tag</span>
                                        }
                                    }
                                </div>
                            }
                        </td>
                        @Html.Raw(RenderAttacksCell(row))
                        <td>@(weapon.Skill.Value)+</td>
                        @Html.Raw(RenderWeaponValueCell(row, "S"))
                        @Html.Raw(RenderWeaponValueCell(row, "AP"))
                        @Html.Raw(RenderWeaponValueCell(row, "D"))
                    </tr>
                    @foreach (var breakdown in row.Breakdown)
                    {
                        <tr class="weapon-contribution-row @(breakdown.SelectKey == null ? "contribution-merged" : "") @(w % 2 == 1 ? "weapon-row-alt" : "")"
                            data-weapon-id="@weaponId" data-group-key="@breakdown.GroupKey"
                            data-merged="@(breakdown.SelectKey == null ? "true" : "false")"
                            data-select-key="@breakdown.SelectKey" data-subtotal-value="@breakdown.SubtotalValue"
                            hidden>
                            <td class="weapon-contribution-label">@breakdown.Label (@(breakdown.Count)&times;@(breakdown.PerModelAttacks))</td>
                            <td>@breakdown.Subtotal</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                        @foreach (var line in breakdown.AttacksLines)
                        {
                            <tr class="weapon-attacks-contribution-row row-bound @(w % 2 == 1 ? "weapon-row-alt" : "")"
                                data-weapon-id="@weaponId" data-amount-total="@(line.Count * line.Amount)" hidden>
                                <td class="weapon-contribution-label weapon-attacks-contribution-label">
                                    @Html.Raw(RenderAttacksContributionLine(line))
                                </td>
                                <td>@(line.Count * line.Amount)</td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                            </tr>
                        }
                    }

                    @foreach (var line in row.GroupWideAttacksLines)
                    {
                        <tr class="weapon-attacks-contribution-row group-wide @(w % 2 == 1 ? "weapon-row-alt" : "")"
                            data-weapon-id="@weaponId" data-amount-total="@(line.Count * line.Amount)" hidden>
                            <td class="weapon-contribution-label weapon-attacks-contribution-label">
                                @Html.Raw(RenderAttacksContributionLine(line))
                            </td>
                            <td>@(line.Count * line.Amount)</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </details>
    }

    @if (unit.Keywords.Any())
    {
        <details class="lp-section" data-section="keywords"
                 open="@(expandedSections.Contains(UnitBlockSection.Keywords))">
            <summary>
                <span class="section-title">Keywords</span>
            </summary>
            <div class="weapon-tags">
                @foreach (var keyword in unit.Keywords)
                {
                    <span class="weapon-tag">@keyword</span>
                }
            </div>
        </details>
    }
</details>

@functions {

    static string AbilityDisplayName(Ability ability) =>
        ability.Origin == AbilityOrigin.Enhancement ? $"✦ {ability.Name}" : ability.Name;

    // Shared lightning-bolt shape for both the Battle-shock toolbar control and a Battle-shocked
    // unit's OC tile - the same glyph, not
    // two independently-drawn bolts that only coincidentally look similar. Inline SVG rather than a
    // Unicode/emoji character, matching .filter-flag-icon's own precedent - fill resolves from
    // currentColor, so the same markup paints white/--amber (toolbar) or the tile's own
    // .stat-value color (OC tile) purely via CSS, with no markup variation needed.
    static string BoltSvgIcon(string cssClass) =>
        $"<svg class=\"{cssClass}\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M9 1 L3 9 L7 9 L6 15 L13 6 L9 6 Z\" /></svg>";

    // Reset Casualties' skull, inline SVG rather than the U+1F480 emoji character: most platforms
    // render an emoji as a fixed, full-color glyph that ignores `color`/`currentColor` entirely,
    // which would keep the icon from ever turning amber when active - the same class of problem
    // BoltSvgIcon above was already built to avoid. fill-rule="evenodd" carves the eye sockets and
    // nasal cavity as true holes (through to whatever's behind the icon - the button's own current
    // background) out of one filled silhouette, rather than layering same-colored shapes that would
    // just blend into a solid blob.
    static string SkullSvgIcon(string cssClass) =>
        $"<svg class=\"{cssClass}\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path fill-rule=\"evenodd\" d=\"M8,1 C4.7,1 2,3.6 2,6.8 C2,8.7 3,10.3 4.5,11.3 L4.5,13 C4.5,13.6 5,14 5.5,14 L10.5,14 C11,14 11.5,13.6 11.5,13 L11.5,11.3 C13,10.3 14,8.7 14,6.8 C14,3.6 11.3,1 8,1 Z M7,6.7 A1.3,1.3 0 1,0 4.4,6.7 A1.3,1.3 0 1,0 7,6.7 Z M11.6,6.7 A1.3,1.3 0 1,0 9,6.7 A1.3,1.3 0 1,0 11.6,6.7 Z M7.4,7.6 L8.6,7.6 L8,9 Z\" /></svg>";

}
