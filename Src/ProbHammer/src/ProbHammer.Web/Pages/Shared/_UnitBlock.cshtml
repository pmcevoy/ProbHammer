@model ProbHammer.Web.Pages.UnitBlockRenderModel
@using System.Net
@using ProbHammer.Core.Domain.Catalogue
@using ProbHammer.Core.Domain.Catalogue.Bsdata
@using ProbHammer.Web.Rendering
@{
    var unit = Model.Unit;
    var i = Model.UnitIndex;
    var glossary = Model.Glossary;

    // The current phase/turn selection's own Expanded set - see LivePlayModel.ExpandedSections.
    // Null (a pre-existing call site that predates this feature) defaults to "nothing expanded",
    // matching this page's original unconditional-collapsed markup.
    var expandedSections = Model.ExpandedSections ?? new HashSet<UnitBlockSection>();

    // Popover trigger/panel building (ability names, resolvable weapon-keyword chips, and nested
    // [BRACKET] references reached from either one's own text) is extracted into RulePopoverRenderer
    // so the header partial can produce the
    // identical markup with no unit page index to scope popover ids against - "u{i}" here matches
    // this unit block's own page index, "hdr" scopes the header's own instance.
    var popovers = new RulePopoverRenderer(glossary, $"u{i}",
        (ability, popoverId) => ApplySectionRenderer.Render(unit.ActivatableConditions, i, ability, popoverId));

    (string Trigger, string Trailer) BuildRulePopover(string triggerHtml, string triggerClass, string ruleText, IReadOnlySet<string> shownRuleNames, Ability? ability = null) =>
        popovers.BuildRulePopover(triggerHtml, triggerClass, ruleText, shownRuleNames, ability: ability);

    // An Attacks contribution line's ability is never re-cited elsewhere in its own text, so it
    // passes an empty shownRuleNames set.
    var noShownRuleNames = new HashSet<string>();

    // Melee reads fine as the plain Unicode glyph; Ranged is a small inline SVG crosshair, since every
    // text-glyph candidate tried live rendered ambiguously in this browser/OS font stack.
    const string rangedIcon = "<svg class=\"insv-icon\" viewBox=\"0 0 16 16\" aria-hidden=\"true\">" +
                              "<circle cx=\"8\" cy=\"8\" r=\"5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" />" +
                              "<line x1=\"8\" y1=\"0\" x2=\"8\" y2=\"3\" stroke=\"currentColor\" stroke-width=\"1.5\" />" +
                              "<line x1=\"8\" y1=\"13\" x2=\"8\" y2=\"16\" stroke=\"currentColor\" stroke-width=\"1.5\" />" +
                              "<line x1=\"0\" y1=\"8\" x2=\"3\" y2=\"8\" stroke=\"currentColor\" stroke-width=\"1.5\" />" +
                              "<line x1=\"13\" y1=\"8\" x2=\"16\" y2=\"8\" stroke=\"currentColor\" stroke-width=\"1.5\" />" +
                              "</svg>";

    // Amber unless every line is a conditional effect that was not added.
    string ProvenanceTileClass(ValueProvenance provenance) =>
        provenance.IsConditionalOnly ? "provenance-tile provenance-cond" : "provenance-tile";

    // A stat tile is a plain <div>, or, when an ability has something to say about its value, the
    // provenance popover's trigger button itself, so the whole tile is the tap target.
    string RenderTile(string cssClass, string innerHtml, ValueProvenance? provenance)
    {
        if (provenance is null)
            return $"<div class=\"{cssClass}\">{innerHtml}</div>";

        var (trigger, trailer) = popovers.BuildProvenancePopover(innerHtml, $"{cssClass} {ProvenanceTileClass(provenance)}", provenance);
        return trigger + trailer;
    }

    // M/T/Sv/W/Ld/OC: fieldKey is the LivePlayModel.GetScalarField name, suffix the printed trailing
    // text (`"`/`+`/none).
    string RenderScalarTile(string label, string fieldKey, StatlineBlockViewModel block, string suffix)
    {
        var view = LivePlayModel.GetScalarField(block.Statline, fieldKey);
        var inner = $"<span class=\"stat-label\">{WebUtility.HtmlEncode(label)}</span>" +
                    $"<span class=\"stat-value\">{WebUtility.HtmlEncode(view.Value.ToString())}{suffix}</span>";
        return RenderTile("stat-tile", inner, block.ProvenanceFor(fieldKey));
    }

    // A Battle-shocked unit's OC shows the toolbar's bolt glyph in the ordinary value color; its
    // provenance popover always exists and explains the 0.
    string RenderObjectiveControlTile(StatlineBlockViewModel block)
    {
        if (!unit.IsBattleShocked)
            return RenderScalarTile("OC", "OC", block, "");

        var inner = "<span class=\"stat-label\">OC</span>" +
                    $"<span class=\"stat-value\">{BoltSvgIcon("oc-battleshock-icon")}</span>";
        return RenderTile("stat-tile", inner, block.ProvenanceFor("OC"));
    }

    // InSv shapes: uniform, melee-only, ranged-only, or split (ranged above melee). A highlighted run
    // with no save (only a not-added conditional save reaches it) renders "–"; an unhighlighted one
    // renders no tile at all.
    string RenderInvulnerableSaveTile(StatlineBlockViewModel block)
    {
        var inv = block.Statline.InSv;
        var save = inv.Value;
        var provenance = block.ProvenanceFor("InSv");
        string valueHtml;
        if (inv.IsCaveated)
            valueHtml = $"<span class=\"stat-value\">{save.MeleeInSv}+</span>";
        else if (save.MeleeInSv == 0 && save.RangedInSv == 0)
        {
            if (provenance is null)
                return "";
            valueHtml = "<span class=\"stat-value\">–</span>";
        }
        else if (save.MeleeInSv == save.RangedInSv)
            valueHtml = $"<span class=\"stat-value\">{save.MeleeInSv}+</span>";
        else if (save.RangedInSv == 0)
            valueHtml = $"<span class=\"stat-value\">⚔ {save.MeleeInSv}+</span>";
        else if (save.MeleeInSv == 0)
            valueHtml = $"<span class=\"stat-value\">{rangedIcon} {save.RangedInSv}+</span>";
        else
            valueHtml = "<span class=\"stat-value stat-value-compact\">" +
                        $"<span>{rangedIcon} {save.RangedInSv}+</span><span>⚔ {save.MeleeInSv}+</span></span>";

        return RenderTile("stat-tile insv-tile", "<span class=\"stat-label\">InSv</span>" + valueHtml, provenance);
    }

    // A highlighted weapon value keeps the row's own <td> background; the inner button carries the
    // highlight, and its panel trails it inside the cell.
    string RenderWeaponValueCell(WeaponRowViewModel row, string field)
    {
        var valueHtml = WebUtility.HtmlEncode(LivePlayModel.GetWeaponScalarField(row.Entry.Profile, field).Value.ToString());
        if (row.ProvenanceFor(field) is not { } provenance)
            return $"<td>{valueHtml}</td>";

        var (trigger, trailer) = popovers.BuildProvenancePopover(valueHtml, ProvenanceTileClass(provenance), provenance);
        return $"<td>{trigger}{trailer}</td>";
    }

    // live-play.js rewrites .weapon-attacks-number on selection changes, never the cell itself, so
    // a provenance trigger inside the cell survives the recompute.
    string RenderAttacksCell(WeaponRowViewModel row)
    {
        var numberHtml = $"<span class=\"weapon-attacks-number\">{WebUtility.HtmlEncode(row.Entry.TotalAttacks.ToString())}</span>";
        if (row.ProvenanceFor("A") is not { } provenance)
            return $"<td class=\"weapon-attacks-value\">{numberHtml}</td>";

        var (trigger, trailer) = popovers.BuildProvenancePopover(numberHtml, ProvenanceTileClass(provenance), provenance);
        return $"<td class=\"weapon-attacks-value\">{trigger}{trailer}</td>";
    }

    // Renders one Attacks ability-contribution line's inner content (resolve-weapon-attacks-effects):
    // the source ability as a popover trigger plus the same (Count×Amount) notation the breakdown's
    // own base rows use. Shared by both a row-bound/partial line and a group-wide line. Wrapped in
    // .attacks-contribution-line, a flex row, because .ability-name-line is display:flex and a bare
    // text sibling after it would drop to its own line.
    string RenderAttacksContributionLine(AttacksContributionLine line)
    {
        var abilityNameHtml = WebUtility.HtmlEncode(AbilityDisplayName(line.SourceAbility));
        string nameHtml;
        if (string.IsNullOrWhiteSpace(line.SourceAbility.Text))
        {
            nameHtml = $"<span class=\"ability-name-line\">{abilityNameHtml}</span>";
        }
        else
        {
            var popover = BuildRulePopover(abilityNameHtml, "ability-name-line", line.SourceAbility.Text, noShownRuleNames, line.SourceAbility);
            nameHtml = popover.Trigger + popover.Trailer;
        }

        return $"<div class=\"attacks-contribution-line\">{nameHtml}<span class=\"weapon-attacks-contribution-amount\">({line.Count}&times;{line.Amount})</span></div>";
    }
}
@* Whole-unit-block collapse: the block itself is a <details>, and
   its name bar is the <summary> - the same full-bar-is-the-trigger affordance every .lp-section
   summary already uses, reused here rather than a small dedicated icon-button (icon-buttons on
   this page are reserved for binary per-unit facts - Half Strength, Battle-shock - not broad
   disclosure, per the unit-toolbar's own convention). Independent of, and nests around, the four
   inner .lp-section <details> below - nested <details> is valid HTML with independent `open`
   state per level, so collapsing this one hides the toolbar and every section without touching
   their own state. Defaults `open` (expanded) on every initial render - see live-play.js's
   swapUnitBlock for how a casualty/status/phase-turn re-render carries a player's own collapse
   choice forward instead of resetting to this default. *@
<details class="unit-block" data-unit-index="@i" open>
    <summary class="unit-name">
        <span class="unit-name-text">@unit.Name</span>
    </summary>

    @* Unit status toolbar: its own row between the unit-name header and
       the Statline section, immune to the header wrapping onto multiple lines for a long unit name.
       All three controls always render - no more hide-when-irrelevant per control. Each is a small
       square icon-button (.unit-toolbar-icon-btn,
       sized like .casualty-btn's existing inc/dec controls) - the ONLY clickable
       area - with its plain-text caption (.unit-toolbar-label, styled like .stat-label) sitting
       beside it, outside the button, never part of the click target. Two independent states,
       purely via color: "actionable" (--bg3 background, clickable) vs. "inert" (--text-dim
       background, `disabled`) - see .unit-toolbar-icon-btn in site.css - and "active" (amber icon)
       vs. "inactive" (white icon), via .is-active. The caption's own color never changes with
       either state - it's a static label, not a status indicator. Each icon+label pair is grouped
       in its own .unit-toolbar-item, separated from its neighbor by a left border rather than a
       literal "|" character - a bordered cell, not a punctuation mark. *@
    <div class="unit-toolbar">
        @* Half-strength: a single-model unit (no computed determination is possible - see
           HalfStrengthResolution/domain-model-11e.md) is always actionable, toggling the
           player-set override; a multi-model unit is always inert (the computed determination is
           read-only) but its icon color still reflects that computed value - collapsed from the
           previous button-vs-span split into "always a button, permanently disabled" in this case,
           matching every other toolbar control's shape. *@
        @if (unit.IsSingleModelUnit)
        {
            <div class="unit-toolbar-item">
                <button type="button"
                        class="unit-toolbar-icon-btn status-glyph-halfstrength @(unit.IsAtOrBelowHalfStrength ? "is-active" : "")"
                        data-unit-index="@i" aria-pressed="@(unit.IsAtOrBelowHalfStrength ? "true" : "false")"
                        aria-label="Toggle at-or-below half strength" title="At or below half strength (tap to set)">
                    <span class="unit-toolbar-glyph">½</span>
                    <span class="unit-toolbar-label">Half Strength</span>
                </button>
            </div>
        }
        else
        {
            <div class="unit-toolbar-item">
                <button type="button"
                        class="unit-toolbar-icon-btn status-glyph-halfstrength @(unit.IsAtOrBelowHalfStrength ? "is-active" : "")"
                        disabled
                        aria-label="At or below half strength (computed)" title="At or below half strength (computed)">
                    <span class="unit-toolbar-glyph">½</span>
                    <span class="unit-toolbar-label">Half Strength</span>
                </button>
            </div>
        }
        @* Battle-shock: always present, always actionable - the app never simulates the
           2D6-vs-Leadership test itself, only records the player's own reported result. Icon color
           alone carries active/inactive (see .unit-toolbar-icon-btn.is-active in site.css). *@
        <div class="unit-toolbar-item">
            <button type="button"
                    class="unit-toolbar-icon-btn status-glyph-battleshock @(unit.IsBattleShocked ? "is-active" : "")"
                    data-unit-index="@i" aria-pressed="@(unit.IsBattleShocked ? "true" : "false")"
                    aria-label="Toggle Battle-shocked" title="Battle-shocked (tap to set)">
                <span class="unit-toolbar-glyph">@Html.Raw(BoltSvgIcon("unit-toolbar-svg-icon"))</span>
                <span class="unit-toolbar-label">Battle-shock</span>
            </button>
        </div>
        @* Reset Casualties: actionable only once there's something to reset - unlike the other two,
           it has no independent "active" fact, so its icon is amber exactly when actionable (see
           .is-active applied alongside `disabled` below, driven by the same HasCasualties check). *@
        <div class="unit-toolbar-item">
            <button type="button"
                    class="unit-toolbar-icon-btn casualty-reset-btn @(unit.HasCasualties ? "is-active" : "")"
                    disabled="@(!unit.HasCasualties)"
                    data-unit-index="@i"
                    aria-label="Reset casualties for this unit"
                    title="Reset casualties for this unit">
                <span class="unit-toolbar-glyph">@Html.Raw(SkullSvgIcon("unit-toolbar-svg-icon"))</span>
                <span class="unit-toolbar-label">Reset Casualties</span>
            </button>
        </div>
    </div>

    @if (unit.Statlines.Any())
    {
        <details class="lp-section" data-section="statline"
                 open="@(expandedSections.Contains(UnitBlockSection.Statline))">
            <summary>
                <span class="section-title">Statline</span>
                <span class="statline-flags">
                    <button type="button" class="filter-flag clear-filter-btn" hidden
                            aria-label="Filtered - click to clear" title="Filtered - click to clear">
                        <svg class="filter-flag-icon" viewBox="0 0 16 16" aria-hidden="true"><path
                                d="M1 2 L15 2 L10 8 L10 13 L6 15 L6 8 Z"/></svg>
                    </button>
                </span>
            </summary>
            @{
                // Every ComponentName-null ability (an Army Rule promotion, e.g. "Templar Vows",
                // and/or - since apply-detachment-rule-keyword-targets - an inbound Detachment-rule
                // ability, e.g. "Faith-Fuelled Resolve") belongs to no single component, and all of
                // them stack together in ONE dedicated grid row above every component's own rows
                // (never spanning through them, unlike a component-wide ability) - the same
                // "one cell holding a list of ability lines" shape a single component's own
                // Datasheet-abilities cell already uses, not one cell per ability.
                // LivePlayModel.BuildWholeUnitAbilitySpans guarantees at most one entry in
                // unit.WholeUnitAbilitySpans, so rowOffset only ever needs to reserve 0 or 1 rows.
                var rowOffset = unit.WholeUnitAbilitySpans.Any() ? 1 : 0;
            }
            <div class="statline-grid">
                @foreach (var wholeUnitSpan in unit.WholeUnitAbilitySpans)
                {
                    var wholeUnitCollapsedClass = wholeUnitSpan.IsFullyDead ? "run-collapsed" : "";
                    var wholeUnitDeadAttr = wholeUnitSpan.IsFullyDead ? "true" : "false";
                    @if (wholeUnitSpan.ModelAbilities.Any() || wholeUnitSpan.UnitAbilities.Any())
                    {
                        <div class="statline-cell col-abilities spans-whole-unit @wholeUnitCollapsedClass"
                             data-dead="@wholeUnitDeadAttr" style="grid-row: 1; grid-column: 2;">
                            @foreach (var ability in wholeUnitSpan.ModelAbilities.Concat(wholeUnitSpan.UnitAbilities))
                            {
                                var (abilityTrigger, abilityTrailer) = BuildRulePopover(WebUtility.HtmlEncode(AbilityDisplayName(ability)), "ability-name-line", ability.Text, new HashSet<string>(), ability);
                                @Html.Raw(abilityTrigger)
                                @Html.Raw(abilityTrailer)
                            }
                        </div>
                    }
                }
                @for (var runIndex = 0; runIndex < unit.Statlines.Count; runIndex++)
                {
                    var block = unit.Statlines[runIndex];
                    var runCollapsedClass = block.IsFullyDead ? "run-collapsed" : "";
                    var runDeadAttr = block.IsFullyDead ? "true" : "false";
                    <div class="statline-cell col-statline @runCollapsedClass" data-run-index="@runIndex"
                         data-dead="@runDeadAttr" style="grid-row: @(runIndex + 1 + rowOffset); grid-column: 1;">
                        @for (var entryIndex = 0; entryIndex < block.Entries.Count; entryIndex++)
                        {
                            var entry = block.Entries[entryIndex];
                            var multiLoadout = entry.Loadouts.Count > 1;
                            <div class="statline-entry">
                                @if (multiLoadout)
                                {
                                    var entryDeadClass = entry.RemainingCount == 0 ? "entry-dead" : "";
                                    <div class="statline-header statline-toggle-group @entryDeadClass">
                                        <span class="select-indicator" aria-hidden="true"></span>
                                        <span class="statline-name">@entry.StatlineName</span>
                                        <span
                                            class="statline-count">(@(entry.RemainingCount)/@(entry.InitialCount))</span>
                                    </div>
                                    var loadoutLabels = block.LoadoutLabels[entryIndex];
                                    <ul class="loadout-breakdown">
                                        @for (var loadoutIndex = 0; loadoutIndex < entry.Loadouts.Count; loadoutIndex++)
                                        {
                                            var loadout = entry.Loadouts[loadoutIndex];
                                            var loadoutCasualtyKey = LivePlayModel.CasualtyKey(i, entry.ComponentName, entry.StatlineName, loadoutIndex);
                                            var loadoutDeadClass = loadout.RemainingCount == 0 ? "loadout-dead" : "";
                                            <li class="loadout-toggle @loadoutDeadClass"
                                                data-select-key="@LivePlayModel.SelectKey(entry.ComponentName, entry.StatlineName, loadoutIndex)">
                                                <span class="select-indicator" aria-hidden="true"></span>
                                                <span class="loadout-label">@loadoutLabels[loadoutIndex]</span>
                                                (@(loadout.RemainingCount)/@(loadout.InitialCount))
                                                <span class="casualty-controls">
                                                    <button type="button" class="casualty-btn casualty-dec"
                                                            data-casualty-key="@loadoutCasualtyKey"
                                                            data-remaining="@loadout.RemainingCount"
                                                            data-initial="@loadout.InitialCount"
                                                            aria-label="Mark casualty"
                                                            disabled="@(loadout.RemainingCount == 0)">&minus;</button>
                                                    <button type="button" class="casualty-btn casualty-inc"
                                                            data-casualty-key="@loadoutCasualtyKey"
                                                            data-remaining="@loadout.RemainingCount"
                                                            data-initial="@loadout.InitialCount"
                                                            aria-label="Restore model"
                                                            disabled="@(loadout.RemainingCount == loadout.InitialCount)">+</button>
                                                </span>
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    var entryCasualtyKey = LivePlayModel.CasualtyKey(i, entry.ComponentName, entry.StatlineName, -1);
                                    var entryDeadClass = entry.RemainingCount == 0 ? "entry-dead" : "";
                                    <div class="statline-header statline-toggle @entryDeadClass"
                                         data-select-key="@LivePlayModel.SelectKey(entry.ComponentName, entry.StatlineName, -1)">
                                        <span class="select-indicator" aria-hidden="true"></span>
                                        <span class="statline-name">@entry.StatlineName</span>
                                        <span
                                            class="statline-count">(@(entry.RemainingCount)/@(entry.InitialCount))</span>
                                        <span class="casualty-controls">
                                            <button type="button" class="casualty-btn casualty-dec"
                                                    data-casualty-key="@entryCasualtyKey"
                                                    data-remaining="@entry.RemainingCount"
                                                    data-initial="@entry.InitialCount" aria-label="Mark casualty"
                                                    disabled="@(entry.RemainingCount == 0)">&minus;</button>
                                            <button type="button" class="casualty-btn casualty-inc"
                                                    data-casualty-key="@entryCasualtyKey"
                                                    data-remaining="@entry.RemainingCount"
                                                    data-initial="@entry.InitialCount" aria-label="Restore model"
                                                    disabled="@(entry.RemainingCount == entry.InitialCount)">+</button>
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                        <div class="statline-tiles">
                            @Html.Raw(RenderScalarTile("M", "M", block, "\""))
                            @Html.Raw(RenderScalarTile("T", "T", block, ""))
                            @Html.Raw(RenderScalarTile("Sv", "Sv", block, "+"))
                            @Html.Raw(RenderScalarTile("W", "W", block, ""))
                            @Html.Raw(RenderScalarTile("Ld", "LD", block, "+"))
                            @Html.Raw(RenderObjectiveControlTile(block))
                            @Html.Raw(RenderInvulnerableSaveTile(block))
                        </div>
                    </div>

                    @if (block.ModelAbilities.Any() || block.UnitAbilities.Any())
                    {
                        <div class="statline-cell col-abilities @runCollapsedClass" data-run-index="@runIndex"
                             data-dead="@runDeadAttr" style="grid-row: @(runIndex + 1 + rowOffset); grid-column: 2;">
                            @foreach (var ability in block.ModelAbilities.Concat(block.UnitAbilities))
                            {
                                var (abilityTrigger, abilityTrailer) = BuildRulePopover(WebUtility.HtmlEncode(AbilityDisplayName(ability)), "ability-name-line", ability.Text, new HashSet<string>(), ability);
                                @Html.Raw(abilityTrigger)
                                @Html.Raw(abilityTrailer)
                            }
                        </div>
                    }
                }

                @foreach (var span in unit.ComponentAbilitySpans)
                {
                    var spanCollapsedClass = span.IsFullyDead ? "run-collapsed" : "";
                    var spanDeadAttr = span.IsFullyDead ? "true" : "false";
                    @if (span.ModelAbilities.Any() || span.UnitAbilities.Any())
                    {
                        <div class="statline-cell col-abilities spans-component @spanCollapsedClass"
                             data-first-run-index="@(span.FirstRunIndex)" data-last-run-index="@(span.LastRunIndex)"
                             data-dead="@spanDeadAttr"
                             style="grid-row: @(span.FirstRunIndex + 1 + rowOffset) / @(span.LastRunIndex + 2 + rowOffset); grid-column: 2;">
                            @foreach (var ability in span.ModelAbilities.Concat(span.UnitAbilities))
                            {
                                var (abilityTrigger, abilityTrailer) = BuildRulePopover(WebUtility.HtmlEncode(AbilityDisplayName(ability)), "ability-name-line", ability.Text, new HashSet<string>(), ability);
                                @Html.Raw(abilityTrigger)
                                @Html.Raw(abilityTrailer)
                            }
                        </div>
                    }
                }
            </div>
        </details>
    }

    @if (unit.RangedWeapons.Any())
    {
        <details class="lp-section" data-section="ranged" open="@(expandedSections.Contains(UnitBlockSection.Ranged))">
            <summary>
                <span class="section-title">Ranged Weapons</span>
                <span class="filter-flag filtered-badge" hidden aria-label="Filtered" title="Filtered">
                    <svg class="filter-flag-icon" viewBox="0 0 16 16" aria-hidden="true"><path
                            d="M1 2 L15 2 L10 8 L10 13 L6 15 L6 8 Z"/></svg>
                </span>
            </summary>
            <table class="weapon-table">
                <colgroup>
                    <col class="col-weapon"/>
                    <col class="col-slot"/>
                    <col class="col-slot"/>
                    <col class="col-slot"/>
                    <col class="col-slot"/>
                    <col class="col-slot"/>
                    <col class="col-slot"/>
                </colgroup>
                <thead>
                <tr>
                    <th>Weapon</th>
                    <th>Rng</th>
                    <th>A</th>
                    <th>BS</th>
                    <th>S</th>
                    <th>AP</th>
                    <th>D</th>
                </tr>
                </thead>
                <tbody>
                @for (var w = 0; w < unit.RangedWeapons.Count; w++)
                {
                    var row = unit.RangedWeapons[w];
                    var weapon = row.Entry.Profile;
                    var weaponId = $"w-{i}-r-{w}";
                    var nameLabel = row.Entry.Name;
                    <tr class="@(w % 2 == 1 ? "weapon-row-alt" : "")" data-weapon-id="@weaponId">
                        <td class="weapon-name">
                            @if (row.ShowsBreakdownTrigger)
                            {
                                <button type="button" class="weapon-name-toggle" data-weapon-id="@weaponId"
                                        aria-expanded="false">
                                    @nameLabel
                                </button>
                            }
                            else
                            {
                                @nameLabel
                            }
                            @if (row.Chips.Count > 0)
                            {
                                <div class="weapon-tags">
                                    @foreach (var chip in row.Chips)
                                    {
                                        var tag = chip.Text;
                                        var rule = glossary.TryResolve(tag);
                                        if (chip.Kind != ChipKind.Native)
                                        {
                                            var (chipTrigger, chipTrailer) = popovers.BuildKeywordChipPopover(chip,
                                                chip.Kind == ChipKind.Granted ? "weapon-tag weapon-tag-granted" : "weapon-tag weapon-tag-cond", rule);
                                            @Html.Raw(chipTrigger)
                                            @Html.Raw(chipTrailer)
                                        }
                                        else if (rule != null)
                                        {
                                            var (tagTrigger, tagTrailer) = BuildRulePopover(WebUtility.HtmlEncode(tag), "weapon-tag weapon-tag-resolved", rule.Text, new HashSet<string> { rule.Name });
                                            @Html.Raw(tagTrigger)
                                            @Html.Raw(tagTrailer)
                                        }
                                        else
                                        {
                                            <span class="weapon-tag weapon-tag-unresolved">@tag</span>
                                        }
                                    }
                                </div>
                            }
                        </td>
                        <td>@(weapon.Range)"</td>
                        @Html.Raw(RenderAttacksCell(row))
                        <td>@(weapon.Skill.Value)+</td>
                        @Html.Raw(RenderWeaponValueCell(row, "S"))
                        @Html.Raw(RenderWeaponValueCell(row, "AP"))
