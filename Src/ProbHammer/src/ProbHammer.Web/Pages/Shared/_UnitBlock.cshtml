@model ProbHammer.Web.Pages.UnitBlockRenderModel
@using System.Net
@using ProbHammer.Core.Domain.Catalogue
@using ProbHammer.Core.Domain.Catalogue.Bsdata
@{
    var unit = Model.Unit;
    var i = Model.UnitIndex;
    var glossary = Model.Glossary;

    // One running counter for every popover trigger/panel pair this unit block renders (ability
    // names, resolvable weapon-keyword chips, and nested [BRACKET] references reached from either
    // one's own text) - only needs to be unique within this unit's own fragment, since "i" (unique
    // across the whole page) is part of every id this produces.
    var popoverCounter = 0;
    string NextPopoverId() => $"{i}-{popoverCounter++}";

    // Builds one trigger/popover pair: triggerHtml is already-safe inline HTML (a plain
    // HtmlEncode'd name/tag for a top-level ability/chip trigger, or an emphasis-rendered bracket
    // label for a nested reference - see RenderNestedReference below); ruleText is the raw source
    // text the popover body renders, itself run through the emphasis renderer (recursing into
    // RenderNestedReference for any further [BRACKET] references inside *that* text - this is what
    // makes nesting work to arbitrary depth, per rules-glossary-popovers' "Nested Reference
    // Popover" requirement, though the real corpus never goes more than one level deep). Returns
    // the trigger's own markup separately from every popover panel this call (and its own nested
    // references) produced, so a caller can splice the trigger in place while emitting every panel
    // as a flow-content sibling later - never nested inside this trigger's own emphasis wrapping
    // (see RuleTextEmphasisRenderer's own doc comment for why that specifically matters).
    //
    // shownRuleNames is every RuleDefinition.Name already being displayed somewhere in this
    // popover's own ancestor chain (empty for a top-level ability trigger; the resolved rule's own
    // Name for a top-level weapon-tag chip, since its popover already shows that rule's text) -
    // threaded down so RenderNestedReference can refuse to re-enter one, which real BSData data
    // makes a genuine, not just theoretical, concern: confirmed real self-references in "Sustained
    // Hits" ("...**[SUSTAINED HITS X]**..."), "Anti" ("...**[ANTI-X Y+]**..."), and "Cleave"
    // ("...**[CLEAVE X]**...") own description text - each would otherwise recurse into its own
    // popover forever (confirmed live: an unguarded first version of this stack-overflowed
    // rendering a real weapon's Sustained Hits chip).
    (string Trigger, string Trailer) BuildRulePopover(string triggerHtml, string triggerClass, string ruleText, IReadOnlySet<string> shownRuleNames)
    {
        var popoverId = NextPopoverId();
        var (bodyInline, bodyPopovers) = RuleTextEmphasisRenderer.Render(ruleText, raw => RenderNestedReference(raw, shownRuleNames));
        var trigger = $"<button type=\"button\" id=\"t-{popoverId}\" class=\"{triggerClass}\" popovertarget=\"p-{popoverId}\" style=\"anchor-name: --a{popoverId}\">{triggerHtml}</button>";
        var panel = $"<div id=\"p-{popoverId}\" class=\"rule-popover\" popover=\"auto\" style=\"position-anchor: --a{popoverId}\"><div class=\"rule-popover-title\">{triggerHtml}</div><div class=\"rule-popover-text\">{bodyInline}</div></div>";
        return (trigger, panel + bodyPopovers);
    }

    // The bracket delegate RuleTextEmphasisRenderer.Render calls for every [BRACKET] token it
    // encounters mid-parse. Normalizes the token's raw text the same way extraction always has
    // (RuleTextTokenizer.Normalize - markup-char/Unicode-whitespace-hyphen cleanup) before
    // resolving it against this unit's own glossary; an unresolved token renders as plain
    // (emphasis-rendered) text with no trigger, per "Leave an unresolved bracket token as plain
    // text" - never causing the surrounding text's own resolution to fail. A token that resolves
    // back to a rule already in shownRuleNames (see BuildRulePopover) also degrades to plain text,
    // the same graceful-fallback treatment as a genuinely unresolved one - tapping it would only
    // ever reopen the popover already showing that exact text, and (for the self-reference case)
    // recursing into it again is exactly what would otherwise overflow the stack.
    (string Inline, string Popovers) RenderNestedReference(string rawInner, IReadOnlySet<string> shownRuleNames)
    {
        var normalized = RuleTextTokenizer.Normalize(rawInner);
        var rule = glossary.TryResolve(normalized);
        var (labelInline, labelPopovers) = RuleTextEmphasisRenderer.Render(rawInner, raw => RenderNestedReference(raw, shownRuleNames));
        if (rule == null || shownRuleNames.Contains(rule.Name))
            return (labelInline, labelPopovers);

        var nextShownRuleNames = new HashSet<string>(shownRuleNames) { rule.Name };
        var (trigger, trailer) = BuildRulePopover(labelInline, "rule-reference", rule.Text, nextShownRuleNames);
        return (trigger, labelPopovers + trailer);
    }
}
<section class="unit-block" data-unit-index="@i">
    <h2 class="unit-name">
        <span class="unit-name-text">@unit.Name</span>
        <span class="unit-status-glyphs">
            @* Half-strength glyph: a single-model unit (no computed determination is possible -
               see HalfStrengthResolution/domain-model-11e.md) always renders it as an interactive
               toggle for the player-set override; a multi-model unit renders it as a passive,
               non-interactive indicator that only appears once the computed determination is true.
               Both share the same "½" text glyph and amber-when-active color rule. *@
            @if (unit.IsSingleModelUnit)
            {
                <button type="button" class="filter-flag status-glyph-halfstrength @(unit.IsAtOrBelowHalfStrength ? "is-active" : "")"
                        data-unit-index="@i" aria-pressed="@(unit.IsAtOrBelowHalfStrength ? "true" : "false")"
                        aria-label="Toggle at-or-below half strength" title="At or below half strength (tap to set)">½</button>
            }
            else
            {
                <span class="filter-flag status-glyph-halfstrength is-active" hidden="@(!unit.IsAtOrBelowHalfStrength)"
                      aria-label="At or below half strength" title="At or below half strength">½</span>
            }
            @* Battle-shock glyph: always present, always interactive - the app never simulates the
               2D6-vs-Leadership test itself, only records the player's own reported result. Outline
               when inactive (currentColor, matching the header's own text color), solid amber when
               active - see .status-glyph-battleshock.is-active in site.css. *@
            <button type="button" class="filter-flag status-glyph-battleshock @(unit.IsBattleShocked ? "is-active" : "")"
                    data-unit-index="@i" aria-pressed="@(unit.IsBattleShocked ? "true" : "false")"
                    aria-label="Toggle Battle-shocked" title="Battle-shocked (tap to set)">
                @Html.Raw(BoltSvgIcon("battleshock-icon"))
            </button>
        </span>
    </h2>

    @if (unit.Statlines.Any())
    {
        <details class="lp-section" data-section="statline">
            <summary>
                <span class="section-title">Statline</span>
                <span class="statline-flags">
                    <button type="button" class="filter-flag clear-filter-btn" hidden
                            aria-label="Filtered - click to clear" title="Filtered - click to clear">
                        <svg class="filter-flag-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M1 2 L15 2 L10 8 L10 13 L6 15 L6 8 Z" /></svg>
                    </button>
                    <button type="button" class="filter-flag casualty-reset-btn casualty-reset-btn-emoji" hidden="@(!unit.HasCasualties)"
                            data-unit-index="@i"
                            aria-label="Reset casualties for this unit" title="Reset casualties for this unit">&#x1F480;</button>
                </span>
            </summary>
            <div class="statline-grid">
                @for (var runIndex = 0; runIndex < unit.Statlines.Count; runIndex++)
                {
                    var block = unit.Statlines[runIndex];
                    var runCollapsedClass = block.IsFullyDead ? "run-collapsed" : "";
                    var runDeadAttr = block.IsFullyDead ? "true" : "false";
                    <div class="statline-cell col-statline @runCollapsedClass" data-run-index="@runIndex" data-dead="@runDeadAttr" style="grid-row: @(runIndex + 1); grid-column: 1;">
                        @for (var entryIndex = 0; entryIndex < block.Entries.Count; entryIndex++)
                        {
                            var entry = block.Entries[entryIndex];
                            var multiLoadout = entry.Loadouts.Count > 1;
                            <div class="statline-entry">
                                @if (multiLoadout)
                                {
                                    var entryDeadClass = entry.RemainingCount == 0 ? "entry-dead" : "";
                                    <div class="statline-header statline-toggle-group @entryDeadClass">
                                        <span class="select-indicator" aria-hidden="true"></span>
                                        <span class="statline-name">@entry.StatlineName</span>
                                        <span class="statline-count">(@(entry.RemainingCount)/@(entry.InitialCount))</span>
                                    </div>
                                    var loadoutLabels = block.LoadoutLabels[entryIndex];
                                    <ul class="loadout-breakdown">
                                        @for (var loadoutIndex = 0; loadoutIndex < entry.Loadouts.Count; loadoutIndex++)
                                        {
                                            var loadout = entry.Loadouts[loadoutIndex];
                                            var loadoutCasualtyKey = LivePlayModel.CasualtyKey(i, entry.ComponentName, entry.StatlineName, loadoutIndex);
                                            var loadoutDeadClass = loadout.RemainingCount == 0 ? "loadout-dead" : "";
                                            <li class="loadout-toggle @loadoutDeadClass" data-select-key="@LivePlayModel.SelectKey(entry.ComponentName, entry.StatlineName, loadoutIndex)">
                                                <span class="select-indicator" aria-hidden="true"></span>
                                                <span class="loadout-label">@loadoutLabels[loadoutIndex]</span> (@(loadout.RemainingCount)/@(loadout.InitialCount))
                                                <span class="casualty-controls">
                                                    <button type="button" class="casualty-btn mod-step-btn casualty-dec" data-casualty-key="@loadoutCasualtyKey" data-remaining="@loadout.RemainingCount" data-initial="@loadout.InitialCount" aria-label="Mark casualty" disabled="@(loadout.RemainingCount == 0)">&minus;</button>
                                                    <button type="button" class="casualty-btn mod-step-btn casualty-inc" data-casualty-key="@loadoutCasualtyKey" data-remaining="@loadout.RemainingCount" data-initial="@loadout.InitialCount" aria-label="Restore model" disabled="@(loadout.RemainingCount == loadout.InitialCount)">+</button>
                                                </span>
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    var entryCasualtyKey = LivePlayModel.CasualtyKey(i, entry.ComponentName, entry.StatlineName, -1);
                                    var entryDeadClass = entry.RemainingCount == 0 ? "entry-dead" : "";
                                    <div class="statline-header statline-toggle @entryDeadClass" data-select-key="@LivePlayModel.SelectKey(entry.ComponentName, entry.StatlineName, -1)">
                                        <span class="select-indicator" aria-hidden="true"></span>
                                        <span class="statline-name">@entry.StatlineName</span>
                                        <span class="statline-count">(@(entry.RemainingCount)/@(entry.InitialCount))</span>
                                        <span class="casualty-controls">
                                            <button type="button" class="casualty-btn mod-step-btn casualty-dec" data-casualty-key="@entryCasualtyKey" data-remaining="@entry.RemainingCount" data-initial="@entry.InitialCount" aria-label="Mark casualty" disabled="@(entry.RemainingCount == 0)">&minus;</button>
                                            <button type="button" class="casualty-btn mod-step-btn casualty-inc" data-casualty-key="@entryCasualtyKey" data-remaining="@entry.RemainingCount" data-initial="@entry.InitialCount" aria-label="Restore model" disabled="@(entry.RemainingCount == entry.InitialCount)">+</button>
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                        <div class="statline-tiles">
                            <div class="stat-tile"><span class="stat-label">M</span><span class="stat-value">@(block.Statline.M)"</span></div>
                            <div class="stat-tile"><span class="stat-label">T</span><span class="stat-value">@(block.Statline.T)</span></div>
                            <div class="stat-tile"><span class="stat-label">Sv</span><span class="stat-value">@(block.Statline.Sv)+</span></div>
                            <div class="stat-tile"><span class="stat-label">W</span><span class="stat-value">@(block.Statline.W)</span></div>
                            <div class="stat-tile"><span class="stat-label">Ld</span><span class="stat-value">@(block.Statline.Ld)+</span></div>
                            @* Battle-shocked: OC renders the same glyph as the header's Battle-shock
                               control, in the tile's own value color (never amber - see
                               design-tokens.md's "controls get amber ink when active, stat values
                               never do") - the "flagged" signal lives entirely in the tile's
                               background (.stat-tile-flagged, shared with the caveated-InSv tile
                               below), not in the glyph's own color. No label change, no caption
                               text: unlike a caveated InSv, there's only one fixed reason, already
                               conveyed by the header glyph. Applies to every run's OC tile in this
                               unit, not only whichever run the header itself sits above - Battle-
                               shocked is one flag for the whole unit (see
                               attached-unit-tracker's Battle-Shocked Status Is Player-Set
                               requirement). *@
                            @if (unit.IsBattleShocked)
                            {
                                <div class="stat-tile stat-tile-flagged"><span class="stat-label">OC</span><span class="stat-value">@Html.Raw(BoltSvgIcon("oc-battleshock-icon"))</span></div>
                            }
                            else
                            {
                                <div class="stat-tile"><span class="stat-label">OC</span><span class="stat-value">@(block.Statline.Oc)</span></div>
                            }
                            @{
                                var inv = block.Statline.InSv;
                            }
                            @* The invulnerable save renders as its own labeled box below the row, GW/Wahapedia-card
                               style, rather than a value stacked inside the Sv tile. The caveated branch is the only
                               place in this file that renders an Ability's Text rather than only its Name - see
                               `redesign-invulnerable-save-display`'s design.md; this is a scoped exception to the
                               page's otherwise name-only ability rendering, not a step toward rendering text
                               generally, since only this one condition has no other way to be shown to the player. *@
                            @{
                                // Melee reads fine as the plain Unicode glyph (text-presentation by default, so it
                                // inherits currentColor); Ranged does not - every text-glyph candidate tried live
                                // (⌖, ◎, ⊙) rendered ambiguously in this browser/OS font stack (a diamond, an "info"
                                // icon, a bullet), so Ranged is a small inline SVG crosshair instead, matching this
                                // file's existing filter-flag icon precedent for exactly the same reason.
                                var rangedIcon = "<svg class=\"insv-icon\" viewBox=\"0 0 16 16\" aria-hidden=\"true\">" +
                                    "<circle cx=\"8\" cy=\"8\" r=\"5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" />" +
                                    "<line x1=\"8\" y1=\"0\" x2=\"8\" y2=\"3\" stroke=\"currentColor\" stroke-width=\"1.5\" />" +
                                    "<line x1=\"8\" y1=\"13\" x2=\"8\" y2=\"16\" stroke=\"currentColor\" stroke-width=\"1.5\" />" +
                                    "<line x1=\"0\" y1=\"8\" x2=\"3\" y2=\"8\" stroke=\"currentColor\" stroke-width=\"1.5\" />" +
                                    "<line x1=\"13\" y1=\"8\" x2=\"16\" y2=\"8\" stroke=\"currentColor\" stroke-width=\"1.5\" />" +
                                    "</svg>";
                            }
                            @* The InSv box is a .stat-tile like M/T/Sv/W/Ld/Oc (label on top, value below, inside
                               one bordered box), not a separate box+label pair beside each other - matches the
                               other Statline attributes' own layout exactly, per direct user feedback. Any
                               attack-type icon rides inside the value line itself (next to the number it
                               qualifies), not the label, so the label is always just "InSv" (or "InSv*" when
                               caveated) across every shape. *@
                            @if (inv.Caveated)
                            {
                                <div class="stat-tile insv-tile stat-tile-flagged">
                                    <span class="stat-label">InSv*</span>
                                    <span class="stat-value">@(inv.MeleeInSv)+</span>
                                </div>
                                <p class="insv-caveat-text">@inv.CaveatAbility!.Text</p>
                            }
                            else if (inv.MeleeInSv == 0 && inv.RangedInSv == 0)
                            {
                                @* Absent - no invulnerable save box at all. *@
                            }
                            else if (inv.MeleeInSv == inv.RangedInSv)
                            {
                                @* Uniform - applies equally to both attack types, so no attack-type icon needed. *@
                                <div class="stat-tile insv-tile">
                                    <span class="stat-label">InSv</span>
                                    <span class="stat-value">@(inv.MeleeInSv)+</span>
                                </div>
                            }
                            else if (inv.RangedInSv == 0)
                            {
                                <div class="stat-tile insv-tile">
                                    <span class="stat-label">InSv</span>
                                    <span class="stat-value">⚔ @(inv.MeleeInSv)+</span>
                                </div>
                            }
                            else if (inv.MeleeInSv == 0)
                            {
                                <div class="stat-tile insv-tile">
                                    <span class="stat-label">InSv</span>
                                    <span class="stat-value">@Html.Raw(rangedIcon) @(inv.RangedInSv)+</span>
                                </div>
                            }
                            else
                            {
                                @* Two stacked rows (ranged above melee), not one line with a "/" separator - each
                                   row reads as a complete, self-contained fact ("ranged: 5+", "melee: 4+") rather
                                   than needing the eye to track a column pairing across a divider. *@
                                <div class="stat-tile insv-tile">
                                    <span class="stat-label">InSv</span>
                                    <span class="stat-value stat-value-compact">
                                        <span>@Html.Raw(rangedIcon) @(inv.RangedInSv)+</span>
                                        <span>⚔ @(inv.MeleeInSv)+</span>
                                    </span>
                                </div>
                            }
                        </div>
                    </div>

                    @if (block.ModelAbilities.Any())
                    {
                        <div class="statline-cell col-model-abilities @runCollapsedClass" data-run-index="@runIndex" data-dead="@runDeadAttr" style="grid-row: @(runIndex + 1); grid-column: 2;">
                            @foreach (var ability in block.ModelAbilities)
                            {
                                var (abilityTrigger, abilityTrailer) = BuildRulePopover(WebUtility.HtmlEncode(AbilityDisplayName(ability)), "ability-name-line", ability.Text, new HashSet<string>());
                                @Html.Raw(abilityTrigger)
                                @Html.Raw(abilityTrailer)
                            }
                        </div>
                    }

                    @if (block.UnitAbilities.Any())
                    {
                        <div class="statline-cell col-unit-abilities @runCollapsedClass" data-run-index="@runIndex" data-dead="@runDeadAttr" style="grid-row: @(runIndex + 1); grid-column: 3;">
                            @foreach (var ability in block.UnitAbilities)
                            {
                                var (abilityTrigger, abilityTrailer) = BuildRulePopover(WebUtility.HtmlEncode(AbilityDisplayName(ability)), "ability-name-line", ability.Text, new HashSet<string>());
                                @Html.Raw(abilityTrigger)
                                @Html.Raw(abilityTrailer)
                            }
                        </div>
                    }
                }

                @foreach (var span in unit.ComponentAbilitySpans)
                {
                    var spanCollapsedClass = span.IsFullyDead ? "run-collapsed" : "";
                    var spanDeadAttr = span.IsFullyDead ? "true" : "false";
                    @if (span.ModelAbilities.Any())
                    {
                        <div class="statline-cell col-model-abilities spans-component @spanCollapsedClass" data-first-run-index="@(span.FirstRunIndex)" data-last-run-index="@(span.LastRunIndex)" data-dead="@spanDeadAttr" style="grid-row: @(span.FirstRunIndex + 1) / @(span.LastRunIndex + 2); grid-column: 2;">
                            @foreach (var ability in span.ModelAbilities)
                            {
                                var (abilityTrigger, abilityTrailer) = BuildRulePopover(WebUtility.HtmlEncode(AbilityDisplayName(ability)), "ability-name-line", ability.Text, new HashSet<string>());
                                @Html.Raw(abilityTrigger)
                                @Html.Raw(abilityTrailer)
                            }
                        </div>
                    }

                    @if (span.UnitAbilities.Any())
                    {
                        <div class="statline-cell col-unit-abilities spans-component @spanCollapsedClass" data-first-run-index="@(span.FirstRunIndex)" data-last-run-index="@(span.LastRunIndex)" data-dead="@spanDeadAttr" style="grid-row: @(span.FirstRunIndex + 1) / @(span.LastRunIndex + 2); grid-column: 3;">
                            @foreach (var ability in span.UnitAbilities)
                            {
                                var (abilityTrigger, abilityTrailer) = BuildRulePopover(WebUtility.HtmlEncode(AbilityDisplayName(ability)), "ability-name-line", ability.Text, new HashSet<string>());
                                @Html.Raw(abilityTrigger)
                                @Html.Raw(abilityTrailer)
                            }
                        </div>
                    }
                }
            </div>
        </details>
    }

    @if (unit.RangedWeapons.Any())
    {
        <details class="lp-section" data-section="ranged">
            <summary>
                <span class="section-title">Ranged Weapons</span>
                <span class="filter-flag filtered-badge" hidden aria-label="Filtered" title="Filtered">
                    <svg class="filter-flag-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M1 2 L15 2 L10 8 L10 13 L6 15 L6 8 Z" /></svg>
                </span>
            </summary>
            <table class="weapon-table">
                <colgroup>
                    <col class="col-weapon" />
                    <col class="col-slot" />
                    <col class="col-slot" />
                    <col class="col-slot" />
                    <col class="col-slot" />
                    <col class="col-slot" />
                    <col class="col-slot" />
                </colgroup>
                <thead>
                    <tr>
                        <th>Weapon</th>
                        <th>Rng</th>
                        <th>A</th>
                        <th>BS</th>
                        <th>S</th>
                        <th>AP</th>
                        <th>D</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var w = 0; w < unit.RangedWeapons.Count; w++)
                    {
                        var row = unit.RangedWeapons[w];
                        var weapon = row.Entry.Profile;
                        var tags = WeaponAbilityTags(weapon);
                        var weaponId = $"w-{i}-r-{w}";
                        <tr class="@(w % 2 == 1 ? "weapon-row-alt" : "")" data-weapon-id="@weaponId">
                            <td class="weapon-name">
                                @if (row.ShowsBreakdownTrigger)
                                {
                                    <button type="button" class="weapon-name-toggle" data-weapon-id="@weaponId" aria-expanded="false">
                                        @weapon.Name
                                    </button>
                                }
                                else
                                {
                                    @weapon.Name
                                }
                                @if (tags.Count > 0)
                                {
                                    <div class="weapon-tags">
                                        @foreach (var tag in tags)
                                        {
                                            var rule = glossary.TryResolve(tag);
                                            if (rule != null)
                                            {
                                                var (tagTrigger, tagTrailer) = BuildRulePopover(WebUtility.HtmlEncode(tag), "weapon-tag weapon-tag-resolved", rule.Text, new HashSet<string> { rule.Name });
                                                @Html.Raw(tagTrigger)
                                                @Html.Raw(tagTrailer)
                                            }
                                            else
                                            {
                                                <span class="weapon-tag weapon-tag-unresolved">@tag</span>
                                            }
                                        }
                                    </div>
                                }
                            </td>
                            <td>@(weapon.Range)"</td>
                            <td class="weapon-attacks-value">@row.Entry.TotalAttacks</td>
                            <td>@(weapon.Skill)+</td>
                            <td>@weapon.S</td>
                            <td>@weapon.Ap</td>
                            <td>@weapon.D</td>
                        </tr>
                        @foreach (var breakdown in row.Breakdown)
                        {
                            <tr class="weapon-contribution-row @(breakdown.SelectKey == null ? "contribution-merged" : "") @(w % 2 == 1 ? "weapon-row-alt" : "")"
                                data-weapon-id="@weaponId" data-group-key="@breakdown.GroupKey"
                                data-merged="@(breakdown.SelectKey == null ? "true" : "false")"
                                data-select-key="@breakdown.SelectKey" data-subtotal-value="@breakdown.SubtotalValue" hidden>
                                <td class="weapon-contribution-label">@breakdown.Label (@(breakdown.Count)&times;@(breakdown.PerModelAttacks))</td>
                                <td></td>
                                <td>@breakdown.Subtotal</td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </details>
    }

    @if (unit.MeleeWeapons.Any())
    {
        <details class="lp-section" data-section="melee">
            <summary>
                <span class="section-title">Melee Weapons</span>
                <span class="filter-flag filtered-badge" hidden aria-label="Filtered" title="Filtered">
                    <svg class="filter-flag-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M1 2 L15 2 L10 8 L10 13 L6 15 L6 8 Z" /></svg>
                </span>
            </summary>
            <table class="weapon-table">
                <colgroup>
                    <col class="col-weapon-melee" />
                    <col class="col-slot" />
                    <col class="col-slot" />
                    <col class="col-slot" />
                    <col class="col-slot" />
                    <col class="col-slot" />
                </colgroup>
                <thead>
                    <tr>
                        <th>Weapon</th>
                        <th>A</th>
                        <th>WS</th>
                        <th>S</th>
                        <th>AP</th>
                        <th>D</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var w = 0; w < unit.MeleeWeapons.Count; w++)
                    {
                        var row = unit.MeleeWeapons[w];
                        var weapon = row.Entry.Profile;
                        var tags = WeaponAbilityTags(weapon);
                        var weaponId = $"w-{i}-m-{w}";
                        <tr class="@(w % 2 == 1 ? "weapon-row-alt" : "")" data-weapon-id="@weaponId">
                            <td class="weapon-name">
                                @if (row.ShowsBreakdownTrigger)
                                {
                                    <button type="button" class="weapon-name-toggle" data-weapon-id="@weaponId" aria-expanded="false">
                                        @weapon.Name
                                    </button>
                                }
                                else
                                {
                                    @weapon.Name
                                }
                                @if (tags.Count > 0)
                                {
                                    <div class="weapon-tags">
                                        @foreach (var tag in tags)
                                        {
                                            var rule = glossary.TryResolve(tag);
                                            if (rule != null)
                                            {
                                                var (tagTrigger, tagTrailer) = BuildRulePopover(WebUtility.HtmlEncode(tag), "weapon-tag weapon-tag-resolved", rule.Text, new HashSet<string> { rule.Name });
                                                @Html.Raw(tagTrigger)
                                                @Html.Raw(tagTrailer)
                                            }
                                            else
                                            {
                                                <span class="weapon-tag weapon-tag-unresolved">@tag</span>
                                            }
                                        }
                                    </div>
                                }
                            </td>
                            <td class="weapon-attacks-value">@row.Entry.TotalAttacks</td>
                            <td>@(weapon.Skill)+</td>
                            <td>@weapon.S</td>
                            <td>@weapon.Ap</td>
                            <td>@weapon.D</td>
                        </tr>
                        @foreach (var breakdown in row.Breakdown)
                        {
                            <tr class="weapon-contribution-row @(breakdown.SelectKey == null ? "contribution-merged" : "") @(w % 2 == 1 ? "weapon-row-alt" : "")"
                                data-weapon-id="@weaponId" data-group-key="@breakdown.GroupKey"
                                data-merged="@(breakdown.SelectKey == null ? "true" : "false")"
                                data-select-key="@breakdown.SelectKey" data-subtotal-value="@breakdown.SubtotalValue" hidden>
                                <td class="weapon-contribution-label">@breakdown.Label (@(breakdown.Count)&times;@(breakdown.PerModelAttacks))</td>
                                <td>@breakdown.Subtotal</td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </details>
    }

    @if (unit.Keywords.Any())
    {
        <div class="keywords">@string.Join(", ", unit.Keywords)</div>
    }
</section>

@functions {
    static string AbilityDisplayName(Ability ability) =>
        ability.Origin == AbilityOrigin.Enhancement ? $"✦ {ability.Name}" : ability.Name;

    // Shared lightning-bolt shape for both the header's Battle-shock toggle and a Battle-shocked
    // unit's OC tile - "the same glyph", per half-strength-and-battleshock-indicators' spec, not
    // two independently-drawn bolts that only coincidentally look similar. Inline SVG rather than a
    // Unicode/emoji character, matching .filter-flag-icon's own precedent (renders identically
    // across browsers/fonts, and fill/stroke both resolve from currentColor) - the header toggle
    // needs two genuinely different paint states (outline vs. solid), which no matched Unicode pair
    // reliably gives. cssClass alone drives the paint state via CSS (see site.css); this helper
    // never varies the markup itself.
    static string BoltSvgIcon(string cssClass) =>
        $"<svg class=\"{cssClass}\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M9 1 L3 9 L7 9 L6 15 L13 6 L9 6 Z\" /></svg>";

    static List<string> WeaponAbilityTags(WeaponProfile w)
    {
        var tags = new List<string>();
        if (w.Torrent) tags.Add("TORRENT");
        if (w.Blast) tags.Add("BLAST");
        if (w.Melta > 0) tags.Add($"MELTA {w.Melta}");
        if (w.RapidFire > 0) tags.Add($"RAPID FIRE {w.RapidFire}");
        if (w.SustainedHits > 0) tags.Add($"SUSTAINED HITS {w.SustainedHits}");
        if (w.LethalHits) tags.Add("LETHAL HITS");
        if (w.DevastatingWounds) tags.Add("DEVASTATING WOUNDS");
        if (w.TwinLinked) tags.Add("TWIN-LINKED");
        if (w.IndirectFire) tags.Add("INDIRECT FIRE");
        if (w.Pistol) tags.Add("PISTOL");
        if (w.IgnoresCover) tags.Add("IGNORES COVER");
        if (w.Assault) tags.Add("ASSAULT");
        foreach (var (keyword, threshold) in w.Anti)
            tags.Add($"ANTI-{keyword.ToUpperInvariant()} {threshold}+");
        return tags;
    }
}
