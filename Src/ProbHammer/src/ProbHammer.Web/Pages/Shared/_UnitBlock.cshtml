                </span>
            </summary>
            <table class="weapon-table">
                <colgroup>
                    <col class="col-weapon-melee"/>
                    <col class="col-slot"/>
                    <col class="col-slot"/>
                    <col class="col-slot"/>
                    <col class="col-slot"/>
                    <col class="col-slot"/>
                </colgroup>
                <thead>
