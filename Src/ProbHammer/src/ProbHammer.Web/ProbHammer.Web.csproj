<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ProbHammer.Core\ProbHammer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="BSData\" />
    <!--Don't copy the BSData implicitly into the image: we'll link in the Dockerfile-->
    <Content Remove="BsData/**" />
    <!--Don't copy Data/ implicitly into the image either: we'll link in the Dockerfile-->
    <Content Remove="Data/**" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
